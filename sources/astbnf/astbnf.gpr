--  Standalone project for ASTBNF: a pure-ABNF schema parser plus C and Ada
--  code emitters.  Pure Ada, no C dependencies.  Built and gprinstalled as a
--  static library by the ada-on-alpine aport.

library project ASTBNF is

   for Languages use ("Ada");
   for Source_Dirs use (".");
   for Object_Dir use "obj";
   for Create_Missing_Dirs use "True";
   for Library_Dir use "lib";
   for Library_Name use "astbnf";

   --  Scenario variable, so gprinstall emits the installed "library_type :=
   --  static" marker that tells consuming projects this is a static library.
   type Library_Type_Type is ("relocatable", "static", "static-pic");
   Library_Type : Library_Type_Type :=
     external ("ASTBNF_LIBRARY_TYPE", external ("LIBRARY_TYPE", "static"));
   for Library_Kind use Library_Type;

   package Compiler is
      --  -gnatwe is deliberately absent, matching hbnf: brittle when rebuilt
      --  against each new GNAT.
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnatwa", "-gnatVa", "-gnato",
         "-gnaty3abcefhiklmnprt");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es");
   end Binder;

   package Install is
      for Active use "True";
   end Install;

end ASTBNF;
