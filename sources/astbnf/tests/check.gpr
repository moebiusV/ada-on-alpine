with "../astbnf.gpr";

--  Check suite for the astbnf schema parser + C/Ada emitters: parses the
--  example schema and asserts the emitted code carries the expected markers.
project Check is
   for Source_Dirs use (".");
   for Object_Dir use "../obj-check";
   for Exec_Dir use ".";
   for Main use ("astbnf_check.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnatwa");
   end Compiler;
end Check;
