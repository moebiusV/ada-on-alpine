--  Builds the example against the *installed* imsg.gpr.  Install the library
--  first (the Alpine imsg package, or a gprinstall), then from this directory:
--
--      GPR_PROJECT_PATH=/usr/share/gpr gprbuild -P examples.gpr -p
with "imsg";

project Examples is
   for Source_Dirs use (".");
   for Object_Dir use "obj";
   for Exec_Dir use ".";
   for Main use ("imsg_example.adb");

   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022");
   end Compiler;
end Examples;
