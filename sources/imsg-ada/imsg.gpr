--  Standalone project for Imsg: OpenBSD's imsg message-passing protocol
--  (the portable imsg.c wire format) ported to Ada.  Pure Ada on the GNAT
--  runtime -- no C dependencies, no external GPR projects.  Built and
--  gprinstalled as a static library by the ada-on-alpine aport.

library project Imsg is

   for Languages use ("Ada");
   for Source_Dirs use (".");
   for Source_Files use ("imsg.ads", "imsg.adb");
   for Object_Dir use "obj";
   for Create_Missing_Dirs use "True";
   for Library_Dir use "lib";
   for Library_Name use "imsg";

   --  Scenario variable, so gprinstall emits the installed "library_type :=
   --  static" marker that tells consuming projects this is a static library
   --  (without it gprbuild defaults to relocatable and forces -lgnat-15).
   type Library_Type_Type is ("relocatable", "static", "static-pic");
   Library_Type : Library_Type_Type :=
     external ("IMSG_LIBRARY_TYPE", external ("LIBRARY_TYPE", "static"));
   for Library_Kind use Library_Type;

   package Compiler is
      --  -gnatwe (warnings-as-errors) is deliberately absent: it is right for
      --  development but brittle in a package rebuilt against each new GNAT.
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnatwa", "-gnatVa", "-gnato",
         "-gnaty3abcefhiklmnprt");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es");
   end Binder;

   package Install is
      for Active use "True";
   end Install;

end Imsg;
