with "../imsg.gpr";

--  Build c_interop against the imsg library: it decodes a frame composed by
--  the C harness (c_compose.c), proving the Ada codec agrees with portable
--  imsg.c's wire format.  Object files land outside the library's own obj/.
project C_Interop is
   for Source_Dirs use (".");
   for Object_Dir use "../obj-cinterop";
   for Exec_Dir use ".";
   for Main use ("c_interop.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnatwa");
   end Compiler;
end C_Interop;
