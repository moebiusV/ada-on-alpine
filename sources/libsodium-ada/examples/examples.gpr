--  Builds the example programs against the *installed* crypto.gpr.  Install
--  the library first (the Alpine libsodium-ada package, or a gprinstall), then
--  from this directory:
--
--      GPR_PROJECT_PATH=/usr/share/gpr gprbuild -P examples.gpr -p
--
--  Each example is a standalone main; run them with ./hash, ./aead, etc.
with "crypto";

project Examples is
   for Source_Dirs use (".");
   for Object_Dir use "obj";
   for Exec_Dir use ".";
   for Main use ("hash.adb", "aead.adb", "sign.adb", "pwhash.adb", "safe.adb");

   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022");
   end Compiler;
end Examples;
