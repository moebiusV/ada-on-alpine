ce5ec53b3778b39a5a7aacb1fdd5217661e27a69df5f3e9e664b3333ed22749f6e3af18b1ef37911eb50aa8839acd4a2c5dbb6d99a4e3e550eb5bd4d6a09cfbf  0001-abuild-fix-infinity-loop-on-awk-getline-error.patch
