# Maintainer: Natanael Copa <ncopa@alpinelinux.org>
#
# Carrier for an abuild patch that is proposed to Alpine (docs/mr/abuild/): GCC 15
# miscompiles -Os -fstack-clash-protection on 32-bit ARM, so armhf and armv7
# builds do not get the flag from default.conf, and the per-architecture flags
# (-fno-plt, pack-relative-relocs) follow the target architecture instead of the
# one abuild was built on.  This overlay build is
# installed first in every build and sweep; pkgrel is above Alpine's so that it
# wins, and the aport is dropped once the change is merged.
pkgname=abuild
pkgver=3.18.0_rc7
pkgrel=4
pkgdesc="Script to build Alpine Packages"
url="https://gitlab.alpinelinux.org/alpine/abuild/"
arch="all"
license="GPL-2.0-only"
depends="
	apk-tools>=3.0.0_rc4
	cmd:getcap
	fakeroot
	musl-utils
	lzip
	openssl>3
	patch
	pkgconf
	scanelf
	tar
	"
makedepends_build="pkgconfig scdoc"
makedepends_host="openssl-dev>3 zlib-dev"
makedepends="$makedepends_host $makedepends_build"
checkdepends="cmd:setcap kyua git"
install="$pkgname.pre-install $pkgname.pre-upgrade"
subpackages="
	apkbuild-cpan:cpan:noarch
	apkbuild-gem-resolver:gems:noarch
	apkbuild-pypi:pypi:noarch
	abuild-rootbld:_rootbld:noarch
	abuild-sudo:_sudo
	$pkgname-zsh-completion
	$pkgname-doc
	"
options="suid"
pkggroups="abuild"
# gitlab.alpinelinux.org answers GitHub Actions runners with HTTP 418 (bot
# protection), so fetch the byte-identical tag archive from the GitHub mirror.
source="abuild-$pkgver.tar.gz::https://github.com/alpinelinux/abuild/archive/refs/tags/$pkgver.tar.gz
	0001-abuild-fix-infinity-loop-on-awk-getline-error.patch
	no-stack-clash-on-32bit-arm.patch
	arch-flags-for-target.patch
	"
builddir="$srcdir"/abuild-$pkgver

build() {
	make VERSION="$pkgver-r$pkgrel"
}

check() {
	# Alpine runs the whole testsuite (make check); that takes hours under
	# emulation, so here only the config tests, which cover this patch.
	make functions.sh tests/Kyuafile Kyuafile tests/testdata/abuild.key.pub
	kyua test tests/functions_test
}

package() {
	make install VERSION="$pkgver-r$pkgrel" DESTDIR="$pkgdir"

	install -m 644 abuild.conf "$pkgdir"/etc/abuild.conf

	install -d -m 775 -g abuild "$pkgdir"/var/cache/distfiles
}

cpan() {
	pkgdesc="Script to generate perl APKBUILD from CPAN"
	depends="$pkgname=$pkgver-r$pkgrel perl perl-libwww perl-json
		perl-module-build perl-module-build-tiny perl-lwp-protocol-https"

	amove usr/bin/apkbuild-cpan
}

gems() {
	pkgdesc="APKBUILD dependency resolver for RubyGems"
	depends="ruby ruby-augeas"

	amove usr/bin/apkbuild-gem-resolver
}

pypi() {
	pkgdesc="Script to generate python3 APKBUILD from PYPI"
	depends="$pkgname=$pkgver-r$pkgrel perl perl-libwww perl-json
		perl-module-build-tiny perl-lwp-protocol-https perl-ipc-system-simple"

	amove usr/bin/apkbuild-pypi
}

_rootbld() {
	pkgdesc="Build packages in chroot"
	depends="$pkgname=$pkgver-r$pkgrel bubblewrap cmd:envsubst"
	mkdir -p "$subpkgdir"
}

_sudo() {
	pkgdesc="Simple privilege elevation tools for building packages"
	depends=""
	install_if="$pkgname=$pkgver-r$pkgrel"

	amove usr/bin/abuild-sudo usr/bin/abuild-apk usr/bin/abuild-adduser \
		usr/bin/abuild-addgroup
}

