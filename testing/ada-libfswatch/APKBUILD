# Maintainer: David Walther <david@clearbrookdistillery.com>
# NOTE: ada_libfswatch.gpr is a PLAIN project upstream (no Library_Name/Kind),
# like libgnatdoc; ALS compiles its sources in-tree. This package precompiles
# them into libada_libfswatch.a at package time and ships an Externally_Built
# project, so consumers link the .a instead of compiling into a shared /tmp
# Object_Dir. Wraps the libfswatch C library (separate fswatch aport); the Ada
# binding is generated from libfswatch.h with `gcc -fdump-ada-spec`.
pkgname=ada-libfswatch
pkgver=26.0.0_git20260916
pkgrel=1
_commit="686d96834e92ed34e1b5dd9239c9ad668f366c70"
pkgdesc="Ada bindings for libfswatch (filesystem change notifications)"
url="https://github.com/AdaCore/ada_libfswatch"
arch="all"
license="GPL-3.0-or-later WITH GCC-exception-3.1"
depends="libgnat gnatcoll fswatch"
makedepends="gcc-gnat gprbuild gnatcoll fswatch build-base"
source="ada_libfswatch-$_commit.tar.gz::https://github.com/AdaCore/ada_libfswatch/archive/$_commit.tar.gz"
builddir="$srcdir/ada_libfswatch-$_commit"

build() {
	# Generate the Ada binding from the installed libfswatch.h. Copy the C API
	# headers to a writable dir (the build user can't write /usr/include) and
	# run gcc there so the .ads files keep the upstream filenames.
	mkdir -p generated c_api
	cp /usr/include/libfswatch/c/*.h c_api/
	( cd c_api && \
		gcc -C -fdump-ada-spec libfswatch.h -D_TIMEZONE_DEFINED && \
		mv *.ads ../generated/ )
	# gcc -fdump-ada-spec mis-handles musl's bits/alltypes.h, emitting spurious
	# anonymous fields typed Extensions.Signed_0 (never declared).
	sed -i '/Extensions\.Signed_0/d' generated/bits_alltypes_h.ads

	# Precompile as a static library (a library-project form of the upstream
	# plain project), so consumers link libada_libfswatch.a instead of compiling
	# the sources into a shared /tmp Object_Dir.
	cat > ada_libfswatch.gpr <<'GPR'
with "c_lib/c_libfswatch";
with "gnatcoll_core";

library project Ada_Libfswatch is
   type Library_Type_Type is ("static");
   Library_Type : Library_Type_Type := external ("LIBRARY_TYPE", "static");

   for Languages use ("Ada");
   for Source_Dirs use ("src", "generated");
   for Object_Dir use "obj";
   for Library_Name use "ada_libfswatch";
   for Library_Dir use "lib";
   for Library_Kind use Library_Type;

   package Compiler is
      for Default_Switches ("Ada") use ("-g", "-O0", "-gnatwa", "-gnaty");
   end Compiler;
end Ada_Libfswatch;
GPR
	gprbuild -p -P ada_libfswatch.gpr -XLIBFSWATCH_PREFIX=/usr -XLIBRARY_TYPE=static
}

check() {
	test -n "$(find "$builddir"/lib -name 'libada_libfswatch.a' | head -1)"
}

package() {
	# Install the prebuilt library (.a + .ali + sources + Externally_Built .gpr).
	gprinstall -p -f -P ada_libfswatch.gpr -XLIBFSWATCH_PREFIX=/usr -XLIBRARY_TYPE=static \
		--prefix="$pkgdir"/usr --build-name=static --build-var=LIBRARY_TYPE

	# gprinstall rewrites the relative `with "c_lib/c_libfswatch"` to a plain
	# `with "c_libfswatch"` (a top-level project-path name), so install the C
	# binding project at /usr/share/gpr/c_libfswatch.gpr and default it to the
	# system fswatch (upstream defaults to the vendored ../libfswatch).
	sed 's|External("LIBFSWATCH_PREFIX", "../libfswatch")|External("LIBFSWATCH_PREFIX", "/usr")|' \
		c_lib/c_libfswatch.gpr > "$pkgdir"/usr/share/gpr/c_libfswatch.gpr
}

sha512sums="
85f8e07a31b2ade7e3ad2b1f08d83a7f0d8a3fa93aefae268c024790a5a069ece39e6f7d26e03832a452855d6e96e1fe284a32a7a5aa114f869c9081b86c3320  ada_libfswatch-686d96834e92ed34e1b5dd9239c9ad668f366c70.tar.gz
"
