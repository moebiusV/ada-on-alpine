# Maintainer: David Walther <david@clearbrookdistillery.com>
# NOTE: The server executable is built by
# gprbuild from gnat/lsp_server.gpr (the Makefile's non-Alire path); the
# generated completion databases in source/{ada,gpr}/generated are committed,
# so no code-generation step is needed. Links every Ada dependency statically
# (libadalang and gpr2 are static-only) while keeping libc dynamic.
pkgname=ada_language_server
pkgver=26.0.0_git20260914
pkgrel=0
_commit="3e0492f4a8a1080811875818b18feeb5fac37646"
pkgdesc="Language Server Protocol server for Ada"
url="https://github.com/AdaCore/ada_language_server"
arch="all"
license="GPL-3.0-or-later"
depends="libgnat gmp"
makedepends="gcc-gnat gprbuild g++ gpr libadalang libadalang-tools lal-refactor
	ada-libfswatch gnatdoc spawn gnatformat vss-extra vss xdiff"
source="ada_language_server-$_commit.tar.gz::https://github.com/AdaCore/ada_language_server/archive/$_commit.tar.gz"
builddir="$srcdir/ada_language_server-$_commit"

build() {
	# Static server executable: libadalang/gpr2 are static-only, and upstream's
	# "static" linker profile (in lsp_server.gpr) adds -static-libstdc++/-static-
	# libgcc so libfswatch's C++ links in, keeping only libc dynamic. BUILD_MODE
	# =prod avoids dev-mode -gnatwe/-gnaty* warnings-as-errors that trip GNAT 15.
	export GPR_PROJECT_PATH=/usr/share/gpr
	FLAGS="-XBUILD_MODE=prod -XLSP_OS=unix -XALS_LIBRARY_TYPE=static \
		-XLIBRARY_TYPE=static -XXMLADA_BUILD=static -XGPR_BUILD=static"
	# s-memory.adb overrides System.Memory; force its recompile, else a stale
	# object survives a GNAT upgrade and breaks the link (see upstream Makefile).
	gprbuild -d -ws -c -u -p -P gnat/lsp_server.gpr $FLAGS s-memory.adb
	gprbuild -p -j"${JOBS:-1}" -P gnat/lsp_server.gpr $FLAGS -XVERSION="$pkgver"
}

check() {
	test -x .obj/server/ada_language_server
	# Smoke-test: --version prints the embedded VERSION and exits 0, which also
	# proves the runtime's dynamic deps (libgnat, gmp) resolve.
	.obj/server/ada_language_server --version | grep -q "ALS version"

	# The static-link invariant: only libc/libgnat/libgmp (plus the compiler's
	# libgcc_s) may stay dynamic. Assert no Ada-stack shared library sneaks in —
	# a stray libadalang/libgpr2/libgnatcoll/etc. here would mean one of the
	# static links silently fell back to a shared library.
	scanelf -n .obj/server/ada_language_server > .need-dyn
	if grep -Eq 'libadalang|libgpr|libgnatcoll|libxmlada|liblangkit|liblktlang|libvss|libmarkdown|libfswatch|libxdiff|libadasat|libprettier|libtemplates' .need-dyn; then
		echo "error: ada_language_server links Ada-stack shared libraries" >&2
		cat .need-dyn >&2
		return 1
	fi
	rm -f .need-dyn
}

package() {
	install -Dm755 .obj/server/ada_language_server \
		"$pkgdir"/usr/bin/ada_language_server
}

sha512sums="
97ceabb689a41fd48e9ad85cfe5904547cd7a29e05c49cf0a9fb74c0daac39cfe565b5316b8ee9517f6bac4c176a68fbff1e4bcc68e5cd8ef6b19723d98fb380  ada_language_server-3e0492f4a8a1080811875818b18feeb5fac37646.tar.gz
"
