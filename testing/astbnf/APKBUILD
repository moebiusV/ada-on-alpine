# Maintainer: David Walther <david@clearbrookdistillery.com>
pkgname=astbnf
pkgver=0.1.0
pkgrel=0
_tag="astbnf-v$pkgver"
pkgdesc="Pure-ABNF schema parser with C and Ada code emitters"
url="https://github.com/moebiusV/ada-on-alpine"
arch="all"
license="ISC"
# Static-only (sources + a static .a + a .gpr): no runtime component, so no
# runtime depends and no -dev split — astbnf is its own dev package.
makedepends="gcc-gnat gprbuild build-base"
# The parser/emitter source lives in THIS repo (sources/astbnf/), so the
# tarball is self-referential.  Pin it to a version tag, never a commit hash
# (a rewritten history breaks a hash pin).  To release: `git tag astbnf-v$pkgver`,
# push the commit and the tag, then `abuild checksum` and commit the new
# sha512sums.
source="ada-on-alpine-$_tag.tar.gz::https://github.com/moebiusV/ada-on-alpine/archive/refs/tags/$_tag.tar.gz"
builddir="$srcdir/ada-on-alpine-$_tag/sources/astbnf"

build() {
	gprbuild -P astbnf.gpr -p -XLIBRARY_TYPE=static
}

check() {
	# Build the check driver against the built library and assert the emitted
	# C and Ada carry the expected markers.
	gprbuild -P tests/check.gpr -p
	./tests/astbnf_check tests/server.astbnf tests/hbnf.astbnf
}

package() {
	gprinstall -P astbnf.gpr -p --prefix="$pkgdir/usr" \
		--sources-subdir=include/astbnf
}

sha512sums="SKIP"  # TODO: `abuild checksum` after pushing astbnf-v0.1.0
