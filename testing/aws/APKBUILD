# Maintainer: David Walther <david@clearbrookdistillery.com>
pkgname=aws
pkgver=26.0.0
pkgrel=0
pkgdesc="Ada Web Server"
url="https://github.com/AdaCore/aws"
arch="all"
license="GPL-3.0-or-later WITH GCC-exception-3.1"
depends="libgnat"
makedepends="gcc-gnat gprbuild xmlada zlib-dev zlib-static build-base"
# templates_parser is a git submodule; pin the exact commit aws 26.0.0 expects.
_tp_commit="cc94ff9833cfe776d462b490aac9727b623742c8"
source="aws-$pkgver.tar.gz::https://github.com/AdaCore/aws/archive/refs/tags/v$pkgver.tar.gz
	templates-parser-$pkgver.tar.gz::https://github.com/AdaCore/templates-parser/archive/$_tp_commit.tar.gz
	zlib-system.patch
	wsdl2aws-name_set.patch
	setup-deps.patch"
builddir="$srcdir/aws-$pkgver"

build() {
	# templates_parser is a git submodule; GitHub archive tarballs omit it,
	# so splice the separately-fetched source into the tree first.
	rm -rf "$srcdir"/aws-$pkgver/templates_parser
	mv "$srcdir"/templates-parser-$_tp_commit "$srcdir"/aws-$pkgver/templates_parser

	# ZLIB=true selects the system zlib (zlib-system.patch makes that apply
	# to static kinds too). ENABLE_SHARED=false builds static-only, matching
	# our gnatcoll/xmlada. setup-deps.patch fixes the parallel-setup race,
	# so no -j1 is needed here.
	make setup prefix=/usr ZLIB=true ENABLE_SHARED=false
	# -j1: the awsres tool and the library both ar libaws.a concurrently
	# (upstream #400) -- serial make avoids that race.
	make -j1 PROCESSORS="${JOBS:-1}" ZLIB=true ENABLE_SHARED=false
}

check() {
	# Stage-install and verify the installed project/library layout.
	mkdir -p "$srcdir"/stage
	# -j1: parallel install races the same way the build does (gprinstall
	# chokes with END_ERROR reading a file another job is mid-writing).
	make -j1 install DESTDIR="$srcdir"/stage prefix=/usr ZLIB=true ENABLE_SHARED=false
	test -f "$srcdir"/stage/usr/share/gpr/aws.gpr
}

package() {
	make -j1 install DESTDIR="$pkgdir" prefix=/usr ZLIB=true ENABLE_SHARED=false
}

