# Maintainer: David Walther <david@clearbrookdistillery.com>
pkgname=aws
pkgver=26.0.0_git20260902
pkgrel=3
_commit="36b0a055f502c071df63fd05a67042dbf5d5dd79"
pkgdesc="Ada Web Server"
url="https://github.com/AdaCore/aws"
arch="all"
license="GPL-3.0-or-later WITH GCC-exception-3.1"
depends="libgnat gnatcoll"
makedepends="gcc-gnat gprbuild xmlada xmlada-static gnatcoll gnatcoll-static zlib-dev zlib-static openssl-dev openssl-libs-static build-base"
subpackages="$pkgname-static"
# templates_parser is a git submodule; pin the commit aws $_commit references.
_tp_commit="7c59ed4f1ee371c7d3f420b890e287b72c2473f4"
source="aws-$_commit.tar.gz::https://github.com/AdaCore/aws/archive/$_commit.tar.gz
	templates-parser-$_tp_commit.tar.gz::https://github.com/AdaCore/templates-parser/archive/$_tp_commit.tar.gz
	zlib-system.patch
	setup-deps.patch
	http2-settings-alignment.patch
	"
builddir="$srcdir/aws-$_commit"

build() {
	# templates_parser is a git submodule; GitHub archive tarballs omit it,
	# so splice the separately-fetched source into the tree first.
	rm -rf "$builddir"/templates_parser
	mv "$srcdir"/templates-parser-$_tp_commit "$builddir"/templates_parser

	# DEBUG=false: the release profile; upstream says the debug profile (-gnatwe)
	# is meant for AWS developers.  http2-settings-alignment.patch fixes the one
	# alignment warning that failed the debug profile on armv7 (not retried).
	# ZLIB=true selects the system zlib (zlib-system.patch makes that apply
	# to static kinds too). SOCKET=openssl builds the real TLS backend against
	# OpenSSL -- the default "std" ships ssl_dummy, which cannot do HTTPS.
	# ENABLE_SHARED=true builds static + relocatable + static-pic (the static
	# archive goes to the -static subpackage).
	# setup-deps.patch fixes the parallel-setup race, so no -j1 is needed here.
	make setup prefix=/usr ZLIB=true ENABLE_SHARED=true SOCKET=openssl DEBUG=false
	# -j1: the awsres tool and the library both ar libaws.a concurrently
	# (upstream #400) -- serial make avoids that race.
	make -j1 PROCESSORS="${JOBS:-1}" ZLIB=true ENABLE_SHARED=true SOCKET=openssl DEBUG=false
}

check() {
	# Stage-install and verify the installed project/library layout.
	mkdir -p "$srcdir"/stage
	# -j1: parallel install races the same way the build does (gprinstall
	# chokes with END_ERROR reading a file another job is mid-writing).
	make -j1 install DESTDIR="$srcdir"/stage prefix=/usr ZLIB=true ENABLE_SHARED=true SOCKET=openssl DEBUG=false
	test -f "$srcdir"/stage/usr/share/gpr/aws.gpr
}

package() {
	make -j1 install DESTDIR="$pkgdir" prefix=/usr ZLIB=true ENABLE_SHARED=true SOCKET=openssl DEBUG=false
}

