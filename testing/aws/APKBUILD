# Maintainer: David Walther <david@clearbrookdistillery.com>
pkgname=aws
pkgver=26.0.0
pkgrel=0
pkgdesc="Ada Web Server"
url="https://github.com/AdaCore/aws"
arch="all"
license="GPL-3.0-or-later WITH GCC-exception-3.1"
depends="libgnat"
makedepends="gcc-gnat gprbuild xmlada zlib-dev build-base"
source="aws-$pkgver.tar.gz::https://github.com/AdaCore/aws/archive/refs/tags/v$pkgver.tar.gz
	templates-parser-$pkgver.tar.gz::https://github.com/AdaCore/templates-parser/archive/refs/tags/v$pkgver.tar.gz"
builddir="$srcdir/aws-$pkgver"

build() {
	# templates_parser is a git submodule; GitHub archive tarballs omit it,
	# so splice the separately-fetched source into the tree first.
	rm -rf "$srcdir"/aws-$pkgver/templates_parser
	mv "$srcdir"/templates-parser-$pkgver "$srcdir"/aws-$pkgver/templates_parser

	# `setup` must be serial: regtests_setup reads makefile.setup before
	# gen_setup writes it under parallel make. ZLIB=true forces the system
	# zlib (the bundled fallback fails to compile under gcc 15).
	make -j1 setup prefix=/usr ZLIB=true
	make PROCESSORS="${JOBS:-1}" ZLIB=true
}

check() {
	# Stage-install and verify the installed project/library layout.
	mkdir -p "$srcdir"/stage
	make install DESTDIR="$srcdir"/stage prefix=/usr ZLIB=true
	test -f "$srcdir"/stage/usr/share/gpr/aws.gpr
}

package() {
	make install DESTDIR="$pkgdir" prefix=/usr ZLIB=true
}

