Fix two missing prerequisites in the `make setup` target graph.

Under `make -jN setup`, two targets can run before the files and
directories they depend on have been created:

1. The *_setup sub-makes read $(TGT_DIR)/makefile.setup (e.g. regtests'
   testsuite.tags rule), but do not depend on gen_setup, which writes it.

2. setup_config writes aws_config.gpr into $(PRJ_DIR), which is created
   by setup_dir, but does not depend on it.

Both lead to non-deterministic failures on parallel builds. Add the
missing prerequisites so `make setup` is safe under -j.

--- a/Makefile
+++ b/Makefile
@@ -135,7 +135,7 @@ GALL_OPTIONS := $(ALL_OPTIONS) \
 	TP_XMLADA="$(TP_XMLADA)" \
 	I_INC="$(I_INC)"

-${MODULES_SETUP}: force
+${MODULES_SETUP}: force gen_setup setup_config
 	${MAKE} -C ${@:%_setup=%} setup $(GALL_OPTIONS)

 ${MODULES_INSTALL}: force
@@ -311,7 +311,7 @@ ifeq (${SOCKET}, std)
 SSL_SUFFIX = dummy
 endif

-setup_config:
+setup_config: setup_dir
 	echo 'abstract project AWS_Config is' > $(CONFGPR)
 	echo '   for Source_Dirs use ();' >> $(CONFGPR)
 	echo >> $(CONFGPR)
