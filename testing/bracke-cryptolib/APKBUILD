# Maintainer: David Walther <david@clearbrookdistillery.com>
pkgname=bracke-cryptolib
pkgver=0.1.0
pkgrel=2
_commit="05c5117f89a4ec7d06633e0d9b546fd0a8f8f90f"
pkgdesc="Pure-Ada cryptography (checksums, ciphers, MACs, random); dependency of bracke-zlib"
url="https://github.com/bracke/cryptolib"
arch="all"
license="MIT"
depends="libgnat"
makedepends="gcc-gnat gprbuild build-base"
source="cryptolib-$_commit.tar.gz::https://github.com/bracke/cryptolib/archive/$_commit.tar.gz
	cryptolib_config.gpr
	bcrypt-prefixes.patch"
builddir="$srcdir/cryptolib-$_commit"
subpackages="$pkgname-static"

build() {
	# Upstream generates config/cryptolib_config.gpr from alire.toml; provide a
	# hand-written copy so the source builds without Alire.
	mkdir -p "$builddir"/config
	cp "$srcdir"/cryptolib_config.gpr "$builddir"/config/cryptolib_config.gpr
	# Relocatable first: cryptolib.gpr doesn't split its object dir by
	# Library_Type, so build the shared lib first (-fPIC objects) and let the
	# static archive reuse them (PIC objects are valid in a .a; the reverse
	# fails the .so link).
	gprbuild -P "$builddir"/cryptolib.gpr -p -XLIBRARY_TYPE=relocatable
	gprbuild -P "$builddir"/cryptolib.gpr -p -XLIBRARY_TYPE=static
}

check() {
	mkdir -p "$srcdir"/stage
	gprinstall -P "$builddir"/cryptolib.gpr -p --prefix="$srcdir"/stage/usr \
		--sources-subdir=include/cryptolib \
		--build-name=static --build-var=LIBRARY_TYPE
	test -f "$srcdir"/stage/usr/share/gpr/cryptolib.gpr
}

package() {
	gprinstall -P "$builddir"/cryptolib.gpr -p -f -XLIBRARY_TYPE=static \
		--prefix="$pkgdir/usr" --sources-subdir=include/cryptolib \
		--build-name=static --build-var=LIBRARY_TYPE
	gprinstall -P "$builddir"/cryptolib.gpr -p -f -XLIBRARY_TYPE=relocatable \
		--prefix="$pkgdir/usr" --sources-subdir=include/cryptolib \
		--build-name=relocatable --build-var=LIBRARY_TYPE
}

