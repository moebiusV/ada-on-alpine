diff --git a/SECURITY.md b/SECURITY.md
index 88ceab5..83fbfba 100644
--- a/SECURITY.md
+++ b/SECURITY.md
@@ -46,6 +46,7 @@ RSASSA-PSS can now be issued as well as verified, which was the last algorithm t
 | X.509 parsing (`ASN1`, `PEM`, `X509.*`) | DER reader, PEM armour, certificate decode, extensions, signature verification | a BIT STRING's padding bits must be zero, as X.690 11.2.1 requires: the key-usage reader indexes bits straight out of the octets, so a certificate setting a bit inside the padding would claim a usage its own encoding does not grant. Checked in the reader rather than at each caller, which is why several callers ignore the unused-bit count; field-by-field against `openssl x509 -text` on the same certificates; an OpenSSL-issued RSA chain verifies here and under `openssl verify`; the machine's own trust store is parsed by the suite rather than measured once and written down here: every certificate in it must decode, with the count left unpinned because it changes when the machine's packages do -- 121 at the time of writing, where an earlier note in this file said 122. That check exists because the DER reader is deliberately strict, and each rule it gains is a chance to reject something the world uses that the crate's own corpus cannot reveal. It is a net for real-world encoding diversity rather than a unique one: a gross over-rejection trips the corpus first, as breaking the reader deliberately showed. An earlier manual measurement also found every `notAfter` agreeing with `openssl x509 -enddate`, and 117 of the self-signatures verifying here. The other five are `sha1WithRSAEncryption`, which this does not verify and reports as unchecked -- none of the 122 comes back as an invalid signature, which is the answer that would mean this crate believes a real root was tampered with |
 | Revocation (`X509.CRLs`, `OCSP`) | CRL and OCSP parsing and signature checking | a serial number must be positive, and that is not pedantry: serials are compared as magnitudes with leading zeros stripped, which is right across the padded encodings a positive serial has and wrong across the sign. DER writes -1 as content `FF` and 255 as `00 FF`, so a list naming -1 reported the certificate whose serial is 255 as revoked. Pinned with two hand-built lists differing only in the serial -- the positive one still revoking is what says the refusal is aimed at the sign rather than at the list; against a CRL and OCSP responses OpenSSL produced through `openssl ca -revoke`; the request builder is byte-identical to `openssl ocsp -reqout`, with and without a nonce; a delegate without OCSP-signing authority is refused; revocation times and reasons match `openssl crl -text`, and the CRL and OCSP paths agree with each other on the same certificate, and agree on what a serial number is -- one comparison serves both, reading a serial as a number so that a padded encoding is not taken for a different certificate, which on this path would look like not being revoked; a CRL scoped by a critical `issuingDistributionPoint` is refused rather than read as a complete list; a statement that names no `nextUpdate` -- which is optional in both a CRL and an OCSP response, and left it with no window to be outside of -- is believed only for `Maximum_Age_Days` from when it was issued, seven by default, because replaying a genuine old "nothing revoked" needs no forgery; a validly signed OCSP response carrying an unrecognised critical extension is refused, in its own extensions or in the entry about the certificate |
 | Key fingerprints (`Fingerprints`) | OpenSSH MD5 and SHA-256 renderings | byte-identical to what `ssh-keygen -l` prints for the same key blobs, Ed25519 and RSA, including that the SHA-256 form carries no base64 padding |
+| Base64 (`Base64`) | RFC 4648 section 4, padded and unpadded | the RFC 4648 section 10 vectors in both forms, and a round trip at every length from 0 to 64 octets. The decoder accepts one spelling of each octet string and nothing else: a character outside the alphabet, white space, a length of 1 modulo 4, a final group whose unused low bits are not zero, padding where none is asked for, and padding that is missing, misplaced or more than two characters are each refused with the output left zero. |
 | Service identity (`X509.Identity`) | RFC 9525 DNS and IP matching | negative cases pinned: a wildcard matches neither the bare domain nor across two labels, an address is never matched as text, and the common name is consulted only when a caller asks for it |
 
 ## Constant-time properties
diff --git a/src/cryptolib-base64.adb b/src/cryptolib-base64.adb
index 6274fc9..c35fe06 100644
--- a/src/cryptolib-base64.adb
+++ b/src/cryptolib-base64.adb
@@ -5,24 +5,30 @@ package body CryptoLib.Base64 is
    Alphabet : constant String :=
      "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
 
-   function Encoded_Length (Count : Natural) return Natural is
-     ((Count / 3) * 4 + (case Count mod 3 is
-                            when 0 => 0,
-                            when 1 => 2,
-                            when others => 3));
-
-   function Decoded_Length (Length : Natural) return Natural is
-     (case Length mod 4 is
-         when 0 => (Length / 4) * 3,
-         when 2 => (Length / 4) * 3 + 1,
-         when 3 => (Length / 4) * 3 + 2,
-         --  One character over a group boundary encodes nothing.
-         when others => 0);
+   function Encoded_Length
+     (Count : Natural; Padded : Boolean := False) return Natural is
+     (if Padded then ((Count + 2) / 3) * 4
+      else (Count / 3) * 4 + (case Count mod 3 is
+                                 when 0 => 0,
+                                 when 1 => 2,
+                                 when others => 3));
+
+   function Decoded_Length
+     (Length : Natural; Padded : Boolean := False) return Natural is
+     (if Padded then (if Length mod 4 = 0 then (Length / 4) * 3 else 0)
+      else
+        (case Length mod 4 is
+            when 0 => (Length / 4) * 3,
+            when 2 => (Length / 4) * 3 + 1,
+            when 3 => (Length / 4) * 3 + 2,
+            --  One character over a group boundary encodes nothing.
+            when others => 0));
 
    procedure Encode
-     (Data : Ada.Streams.Stream_Element_Array;
-      Into : out String;
-      Last : out Natural)
+     (Data   : Ada.Streams.Stream_Element_Array;
+      Into   : out String;
+      Last   : out Natural;
+      Padded : Boolean := False)
    is
       Cursor : Stream_Element_Offset := Data'First;
       Out_At : Natural := Into'First;
@@ -34,7 +40,7 @@ package body CryptoLib.Base64 is
       end Put;
    begin
       Last := Into'First - 1;
-      if Into'Length < Encoded_Length (Natural (Data'Length)) then
+      if Into'Length < Encoded_Length (Natural (Data'Length), Padded) then
          return;
       end if;
 
@@ -55,6 +61,13 @@ package body CryptoLib.Base64 is
             end if;
             if Remaining > 2 then
                Put (Trio mod 64);
+            elsif Padded then
+               Into (Out_At) := '=';
+               Out_At := Out_At + 1;
+               if Remaining = 1 then
+                  Into (Out_At) := '=';
+                  Out_At := Out_At + 1;
+               end if;
             end if;
             Cursor := Cursor + 3;
          end;
@@ -62,7 +75,9 @@ package body CryptoLib.Base64 is
       Last := Out_At - 1;
    end Encode;
 
-   procedure Decode
+   --  Decode for text without padding. A refusal may come after earlier groups
+   --  were written; Decode zeroes them, so that no caller sees half a result.
+   procedure Decode_Unpadded
      (Text  : String;
       Into  : out Ada.Streams.Stream_Element_Array;
       Last  : out Ada.Streams.Stream_Element_Offset;
@@ -143,6 +158,40 @@ package body CryptoLib.Base64 is
 
       Last := Out_At - 1;
       Valid := True;
+   end Decode_Unpadded;
+
+   procedure Decode
+     (Text   : String;
+      Into   : out Ada.Streams.Stream_Element_Array;
+      Last   : out Ada.Streams.Stream_Element_Offset;
+      Valid  : out Boolean;
+      Padded : Boolean := False)
+   is
+      Stop : Natural := Text'Last;
+   begin
+      Into := [others => 0];
+      Last := Into'First - 1;
+      Valid := False;
+
+      if Padded then
+         --  Whole groups only, and at most two `=` at the very end; what is
+         --  left is an unpadded encoding, decoded (strictly) as one.
+         if Text'Length mod 4 /= 0 then
+            return;
+         end if;
+         if Stop >= Text'First and then Text (Stop) = '=' then
+            Stop := Stop - 1;
+            if Text (Stop) = '=' then
+               Stop := Stop - 1;
+            end if;
+         end if;
+      end if;
+
+      Decode_Unpadded (Text (Text'First .. Stop), Into, Last, Valid);
+      if not Valid then
+         Into := [others => 0];
+         Last := Into'First - 1;
+      end if;
    end Decode;
 
 end CryptoLib.Base64;
diff --git a/src/cryptolib-base64.ads b/src/cryptolib-base64.ads
index 84760c3..df025c3 100644
--- a/src/cryptolib-base64.ads
+++ b/src/cryptolib-base64.ads
@@ -1,54 +1,69 @@
 with Ada.Streams;
 
---  @summary Unpadded standard base64, the encoding two unrelated formats in
---  this crate both happen to need.
+--  @summary Standard base64 (RFC 4648 section 4), padded or unpadded, with a
+--  decoder that accepts exactly one spelling of each octet string.
 --
---  A **private child**: machinery for CryptoLib's own packages and reachable
---  from nowhere else. OpenSSH key fingerprints are unpadded base64, and so is
---  every field of an Argon2 PHC string; the encoder existed inside
---  CryptoLib.Fingerprints' body, where the second caller could not reach it.
---  One copy, for the same reason CryptoLib.Blowfish exists.
+--  Standard alphabet -- A-Z a-z 0-9 + / -- not the URL-safe variant. The
+--  default is no padding, which is what the two formats this crate reads
+--  itself specify: OpenSSH key fingerprints are unpadded base64, and so is
+--  every field of an Argon2 PHC string. A caller whose format pads -- most
+--  text formats do -- passes `Padded => True`. The two forms share one decoder,
+--  so the strictness described under Decode holds for both.
 --
---  Standard alphabet -- A-Z a-z 0-9 + / -- and no padding, which is what both
---  formats specify. This is not the URL-safe variant and does not accept `=`.
-private package CryptoLib.Base64 is
+--  This package is public so that code built on this crate need not carry a
+--  second copy of an encoding that is easy to get subtly wrong. CryptoLib.PEM
+--  decodes its own armour, line breaks included, and does not go through it.
+package CryptoLib.Base64 is
 
-   --  The encoded length of Count octets, with no padding.
-   --  @param Count the number of octets to encode
+   --  The encoded length of Count octets.
+   --  @param Count  the number of octets to encode
+   --  @param Padded whether the encoding is padded with `=` to a multiple of 4
    --  @return the number of characters the encoding occupies
-   function Encoded_Length (Count : Natural) return Natural;
+   function Encoded_Length
+     (Count : Natural; Padded : Boolean := False) return Natural;
 
    --  The largest number of octets an encoding of Length characters can
-   --  decode to. A length of 1 modulo 4 is not a valid encoding at all.
+   --  decode to. A length of 1 modulo 4 is not a valid unpadded encoding at
+   --  all, and a padded one is always a multiple of 4 (it may decode to up to
+   --  two octets fewer than the figure given, for its `=`).
    --  @param Length the number of characters
+   --  @param Padded whether the encoding is padded
    --  @return the octet count, or 0 when Length cannot be an encoding
-   function Decoded_Length (Length : Natural) return Natural;
+   function Decoded_Length
+     (Length : Natural; Padded : Boolean := False) return Natural;
 
    --  Encode.
    --  @param Data   the octets to encode
    --  @param Into   out: the characters, from Into'First
    --  @param Last   out: the last character written, Into'First - 1 when Into
    --    is too small
+   --  @param Padded whether to end a short final group with `=` (one for two
+   --    octets, two for one) so that the length is a multiple of 4
    procedure Encode
-     (Data : Ada.Streams.Stream_Element_Array;
-      Into : out String;
-      Last : out Natural);
+     (Data   : Ada.Streams.Stream_Element_Array;
+      Into   : out String;
+      Last   : out Natural;
+      Padded : Boolean := False);
 
    --  Decode, strictly.
    --
    --  Refuses anything that is not the exact encoding of some octet string:
-   --  a character outside the alphabet, padding, whitespace, a length of 1
+   --  a character outside the alphabet, whitespace, padding where Padded is
+   --  False, missing or misplaced padding where it is True, a length of 1
    --  modulo 4, and a final group whose unused low bits are not zero -- the
    --  last of these being what lets two different strings decode to the same
    --  octets, which a format that is compared as text must not allow.
    --  @param Text  the characters to decode
-   --  @param Into  out: the octets, from Into'First
+   --  @param Into  out: the octets, from Into'First; all zero on a refusal
    --  @param Last  out: the last octet written, Into'First - 1 on failure
    --  @param Valid out: True only when Text is exactly an encoding
+   --  @param Padded whether Text must end in `=` to a multiple of 4 (when
+   --    False, it must contain none)
    procedure Decode
-     (Text  : String;
-      Into  : out Ada.Streams.Stream_Element_Array;
-      Last  : out Ada.Streams.Stream_Element_Offset;
-      Valid : out Boolean);
+     (Text   : String;
+      Into   : out Ada.Streams.Stream_Element_Array;
+      Last   : out Ada.Streams.Stream_Element_Offset;
+      Valid  : out Boolean;
+      Padded : Boolean := False);
 
 end CryptoLib.Base64;
diff --git a/tests/src/tests_encodings.adb b/tests/src/tests_encodings.adb
index 0a9e88d..72519aa 100644
--- a/tests/src/tests_encodings.adb
+++ b/tests/src/tests_encodings.adb
@@ -5,6 +5,7 @@ with Ada.Text_IO;
 with Interfaces;
 with System;
 with CryptoLib.ASN1;
+with CryptoLib.Base64;
 with CryptoLib.PEM;
 with CryptoLib.X509;
 with CryptoLib.X509.Certificates;
@@ -2101,6 +2102,120 @@ package body Tests_Encodings is
       end;
    end Check_PKCS12;
 
+   --  CryptoLib.Base64: the RFC 4648 section 10 vectors in both forms, a round
+   --  trip at every length, and the refusals -- each of which must leave the
+   --  output zeroed and say nothing was written.
+   procedure Check_Base64 is
+      use CryptoLib.Base64;
+
+      function Encode (Plain : String; Padded : Boolean) return String is
+         Data : constant Ada.Streams.Stream_Element_Array := Bytes_From_String (Plain);
+         Text : String (1 .. Encoded_Length (Plain'Length, Padded) + 4);
+         Last : Natural;
+      begin
+         Encode (Data, Text, Last, Padded);
+         Check (Last = Encoded_Length (Plain'Length, Padded), "base64: Encoded_Length is what Encode writes");
+         return Text (1 .. Last);
+      end Encode;
+
+      function Decode (Text : String; Padded : Boolean) return String is
+         Data  : Ada.Streams.Stream_Element_Array (1 .. Ada.Streams.Stream_Element_Offset (Text'Length));
+         Last  : Ada.Streams.Stream_Element_Offset;
+         Valid : Boolean;
+         Plain : String (1 .. Text'Length);
+      begin
+         Decode (Text, Data, Last, Valid, Padded);
+         Check (Valid, "base64: """ & Text & """ is refused");
+         Check (Natural (Last) <= Decoded_Length (Text'Length, Padded), "base64: Decoded_Length is a bound");
+         for Index in 1 .. Natural (Last) loop
+            Plain (Index) := Character'Val (Data (Ada.Streams.Stream_Element_Offset (Index)));
+         end loop;
+         return Plain (1 .. Natural (Last));
+      end Decode;
+
+      procedure Expect_Refused (Text : String; Padded : Boolean) is
+         Data  : Ada.Streams.Stream_Element_Array (1 .. Ada.Streams.Stream_Element_Offset (Text'Length) + 3) :=
+           [others => 16#AA#];
+         Last  : Ada.Streams.Stream_Element_Offset;
+         Valid : Boolean;
+      begin
+         Decode (Text, Data, Last, Valid, Padded);
+         Check (not Valid, "base64: """ & Text & """ is accepted");
+         Check (Last = Data'First - 1, "base64: a refusal says nothing was written");
+         Check (Data = Ada.Streams.Stream_Element_Array'(Data'Range => 0), "base64: a refusal leaves the output zero");
+      end Expect_Refused;
+
+      --  One RFC 4648 section 10 test vector, in both directions and both forms.
+      procedure Vector (Plain, Padded_Text, Unpadded_Text : String) is
+      begin
+         Check (Encode (Plain, True) = Padded_Text, "base64: padded encoding of """ & Plain & """");
+         Check (Encode (Plain, False) = Unpadded_Text, "base64: unpadded encoding of """ & Plain & """");
+         Check (Decode (Padded_Text, True) = Plain, "base64: padded decoding of """ & Padded_Text & """");
+         Check (Decode (Unpadded_Text, False) = Plain, "base64: unpadded decoding of """ & Unpadded_Text & """");
+      end Vector;
+   begin
+      Vector ("", "", "");
+      Vector ("f", "Zg==", "Zg");
+      Vector ("fo", "Zm8=", "Zm8");
+      Vector ("foo", "Zm9v", "Zm9v");
+      Vector ("foob", "Zm9vYg==", "Zm9vYg");
+      Vector ("fooba", "Zm9vYmE=", "Zm9vYmE");
+      Vector ("foobar", "Zm9vYmFy", "Zm9vYmFy");
+
+      --  Every length from 0 to 64 octets, with every octet value in the mix.
+      for Length in 0 .. 64 loop
+         declare
+            Plain : String (1 .. Length);
+         begin
+            for Index in Plain'Range loop
+               Plain (Index) := Character'Val ((Index * 37 + Length * 11) mod 256);
+            end loop;
+            Check (Decode (Encode (Plain, True), True) = Plain, "base64: padded round trip");
+            Check (Decode (Encode (Plain, False), False) = Plain, "base64: unpadded round trip");
+            Check (Encode (Plain, True)'Length mod 4 = 0, "base64: padded text is whole groups");
+         end;
+      end loop;
+
+      --  The standard alphabet, not the URL-safe one: FB FF encodes with '+' and '/'.
+      Check (Encode (Character'Val (16#FB#) & Character'Val (16#FF#), True) = "+/8=",
+             "base64: the alphabet ends in '+' and '/'");
+
+      --  Lengths: a padded encoding is whole groups, an unpadded one may end short.
+      Check (Encoded_Length (0) = 0 and then Encoded_Length (1) = 2 and then Encoded_Length (2) = 3
+             and then Encoded_Length (3) = 4 and then Encoded_Length (1, True) = 4
+             and then Encoded_Length (2, True) = 4 and then Encoded_Length (4, True) = 8,
+             "base64: Encoded_Length");
+      Check (Decoded_Length (4) = 3 and then Decoded_Length (2) = 1 and then Decoded_Length (3) = 2
+             and then Decoded_Length (5) = 0 and then Decoded_Length (4, True) = 3
+             and then Decoded_Length (3, True) = 0 and then Decoded_Length (2, True) = 0,
+             "base64: Decoded_Length");
+
+      --  Refusals. A decoder that accepts two spellings of one value cannot be used where the text is
+      --  compared, so the stray low bits of a short final group are among them.
+      for Padded in Boolean loop
+         Expect_Refused ("Zm9v!", Padded);         --  outside the alphabet
+         Expect_Refused ("Zm9 v", Padded);         --  white space
+         Expect_Refused ("Zm9v" & Character'Val (10), Padded);
+         Expect_Refused ("Zm9v-_", Padded);        --  the URL-safe alphabet
+      end loop;
+      Expect_Refused ("Z", False);                 --  one character over a group encodes nothing
+      Expect_Refused ("Zm9vY", False);
+      Expect_Refused ("Zh", False);                --  stray low bits: "Zg" is the spelling
+      Expect_Refused ("Zm9=", False);              --  padding where none is asked for
+      Expect_Refused ("Zg==", False);
+      Expect_Refused ("Zg", True);                 --  padding missing
+      Expect_Refused ("Zg=", True);
+      Expect_Refused ("Zm9", True);
+      Expect_Refused ("Zg===", True);              --  too much of it
+      Expect_Refused ("Z===", True);
+      Expect_Refused ("====", True);
+      Expect_Refused ("Z=g=", True);               --  in the middle
+      Expect_Refused ("Zg=a", True);               --  not at the end
+      Expect_Refused ("Zh==", True);               --  stray low bits
+      Expect_Refused ("Zm9=", True);
+      Expect_Refused ("Zm9v=", True);              --  not whole groups
+   end Check_Base64;
+
    --  AUnit routine wrappers. Each check is a test of its own, so a
