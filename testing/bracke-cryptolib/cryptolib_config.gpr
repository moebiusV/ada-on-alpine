--  Configuration for the cryptolib crate.  Upstream generates this from
--  alire.toml; this hand-written copy lets the source build without Alire.
--  Only the fields cryptolib.gpr reads are populated.

abstract project Cryptolib_Config is

   Crate_Version := "0.1.0";
   Crate_Name    := "cryptolib";

   Alire_Host_OS     := "linux";
   Alire_Host_Arch   := "x86_64";
   Alire_Host_Distro := "unknown";

   Ada_Compiler_Switches := External_As_List ("ADAFLAGS", " ");
   Ada_Compiler_Switches := Ada_Compiler_Switches & ("-O2", "-g");

   type Build_Profile_Kind is ("release", "validation", "development");
   Build_Profile : Build_Profile_Kind := "development";

end Cryptolib_Config;
