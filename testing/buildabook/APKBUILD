# Maintainer: David Walther <david@clearbrookdistillery.com>
pkgname=buildabook
pkgver=0.1.0_git20261023
pkgrel=0
_commit="96160fb5e8c83761cefaccd3536ac73161519858"
pkgdesc="Build tool for long manuscripts: outline + chapter sources -> Typst book"
url="https://github.com/moebiusV/buildabook"
# Needs hbnf at build time, which is only built where GNAT has 128-bit
# integers (not x86, armhf or armv7).
arch="x86_64 aarch64 ppc64le s390x riscv64 loongarch64"
license="ISC"
depends="libgnat mustache-ada"
makedepends="gcc-gnat gprbuild build-base hbnf"
checkdepends="aunit"
source="buildabook-$_commit.tar.gz::https://github.com/moebiusV/buildabook/archive/$_commit.tar.gz"
builddir="$srcdir/buildabook-$_commit"

build() {
	gprbuild -P buildabook.gpr -p
}

check() {
	gprbuild -P tests/tests.gpr -p
	./tests/tests

	# The checked-in parsers must be what the installed hbnf generates from
	# the grammars (regen.sh needs hbnf main of 2026-10-22 or later).
	cp -r src "$srcdir"/src.checked-in
	sh grammars/regen.sh
	diff -r "$srcdir"/src.checked-in src
}

package() {
	install -Dm755 buildabook "$pkgdir"/usr/bin/buildabook
	install -Dm644 man/buildabook.1 "$pkgdir"/usr/share/man/man1/buildabook.1
	gzip -9 "$pkgdir"/usr/share/man/man1/buildabook.1
}
sha512sums="2950775cb16c6b209a43dfac632f4093f357a90248b14dbf650c85cbbe3b66cb71a7d6973e87640c74050bc56d226414ccf53ade5c3ee8adf90f07c67f470053  buildabook-96160fb5e8c83761cefaccd3536ac73161519858.tar.gz"
