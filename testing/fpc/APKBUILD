# Maintainer: David Walther <david@clearbrookdistillery.com>
pkgname=fpc
pkgver=3.2.2
pkgrel=0
pkgdesc="Free Pascal Compiler (binary bootstrap; the compiler ppcx64 is a static musl-runnable binary)"
url="https://www.freepascal.org/"
# x86_64 only: Free Pascal publishes a prebuilt linux bootstrap for x86_64;
# other arches would need a full self-hosted source bootstrap.
arch="x86_64"
license="GPL-2.0-or-later AND LGPL-2.0-or-later"
# The official binary distribution: install.sh lays out the compiler, RTL and
# units.  bash runs install.sh; binutils (ld/as/ar) is what fpc drives to link.
makedepends="bash"
depends="binutils"
options="!strip"
source="fpc-$pkgver.x86_64-linux.tar::https://downloads.freepascal.org/fpc/dist/$pkgver/x86_64-linux/fpc-$pkgver.x86_64-linux.tar"
builddir="$srcdir/fpc-$pkgver.x86_64-linux"

build() {
	# install.sh prompts for a prefix, then docs/demos.  Feed the answers.
	# Stage into $srcdir (not $pkgdir, which build() does not see); package()
	# copies the tree into $pkgdir/usr.
	printf "$srcdir/stage\nn\nn\nn\n" | ./install.sh
}

package() {
	# The staged tree mirrors the /usr hierarchy (bin/, lib/fpc/…, share/…).
	mkdir -p "$pkgdir"/usr
	cp -a "$srcdir"/stage/. "$pkgdir"/usr/

	# install.sh wrote bin/ppcx64 as an absolute symlink into the staging
	# dir; make it relative so it resolves to /usr/lib/fpc/... at runtime.
	ln -sf ../lib/fpc/$pkgver/ppcx64 "$pkgdir"/usr/bin/ppcx64

	# The distribution bundles auxiliary tools linked against glibc
	# (fpcmkcfg, fppkg, pas2js, fpdoc, …) and libpas2jslib.so, none of which
	# run on musl.  The static core — bin/fpc and the ppcx64 compiler — is
	# what works.  Drop every dynamically-linked ELF: scanelf -q -n prints
	# the needed libs for a dynamic binary and nothing for a static one or
	# for the .ppu/.o/.a unit files.
	find "$pkgdir"/usr -type f | while read -r f; do
		if [ -n "$(scanelf -q -n "$f" 2>/dev/null)" ]; then
			rm -f "$f"
		fi
	done
	# Remove dirs emptied by the sweep and any dangling symlinks left behind.
	find "$pkgdir"/usr -type d -empty -delete
	find "$pkgdir"/usr -type l ! -exec test -e {} \; -delete

	# fpc.cfg: the unit search path.  install.sh lays the units under
	# /usr/lib/fpc/$pkgver/units/$CARCH-linux/{rtl,fcl-*,packages-*,...};
	# the trailing * tells fpc to search every subdirectory.  $fpcversion and
	# $fpctarget are substituted by fpc at startup.
	mkdir -p "$pkgdir"/etc
	cat > "$pkgdir"/etc/fpc.cfg <<EOF
# /etc/fpc.cfg — generated by the ada-on-alpine fpc aport
-Fu/usr/lib/fpc/\$fpcversion/units/\$fpctarget/*
EOF
}
sha512sums="
534df830a951824525044479ded23ef1e61b104c0dd65c837ad0d8d9ced9eb7349925a3f759756aa95ae17e567d8b1cd5c7e2092d3c665eaac578845b48aa467  fpc-3.2.2.x86_64-linux.tar
"
