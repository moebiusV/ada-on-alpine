# Maintainer: David Walther <david@clearbrookdistillery.com>
pkgname=gnatcoll-projects
pkgver=26.0.0_git20260915
pkgrel=1
_commit="358c384d11ad0d9d26d78744d3a78259c3ce0451"
pkgdesc="GNAT Components Collection – project file support"
url="https://github.com/AdaCore/gnatcoll-core"
arch="all"
license="GPL-3.0-or-later WITH GCC-exception-3.1"
depends="libgnat gnatcoll libgpr"
makedepends="gcc-gnat gprbuild gnatcoll gnatcoll-static libgpr libgpr-static"
subpackages="$pkgname-static"
source="gnatcoll-$_commit.tar.gz::https://github.com/AdaCore/gnatcoll-core/archive/$_commit.tar.gz"
builddir="$srcdir/gnatcoll-core-$_commit"

build() {
	# Object_Dir/Library_Dir split by Library_Type (obj/gnatcoll_projects/pic
	# vs /static), so both kinds build in one tree.
	gprbuild -p -P projects/gnatcoll_projects.gpr \
		-XLIBRARY_TYPE=relocatable -XGNATCOLL_VERSION=26.0.0
	gprbuild -p -P projects/gnatcoll_projects.gpr \
		-XLIBRARY_TYPE=static -XGNATCOLL_VERSION=26.0.0
}

check() {
	# Stage-install and verify the installed project/library layout.
	gprinstall -p -f -P projects/gnatcoll_projects.gpr \
		-XLIBRARY_TYPE=static -XGNATCOLL_VERSION=26.0.0 \
		--prefix="$srcdir"/stage/usr \
		--sources-subdir=include/gnatcoll_projects \
		--build-name=static --build-var=LIBRARY_TYPE
	test -f "$srcdir"/stage/usr/share/gpr/gnatcoll_projects.gpr
	test -n "$(find "$srcdir"/stage/usr/lib -name 'libgnatcoll_projects.a' | head -1)"
}

package() {
	gprinstall -p -f -P projects/gnatcoll_projects.gpr \
		-XLIBRARY_TYPE=static -XGNATCOLL_VERSION=26.0.0 \
		--prefix="$pkgdir"/usr \
		--sources-subdir=include/gnatcoll_projects \
		--build-name=static --build-var=LIBRARY_TYPE
	gprinstall -p -f -P projects/gnatcoll_projects.gpr \
		-XLIBRARY_TYPE=relocatable -XGNATCOLL_VERSION=26.0.0 \
		--prefix="$pkgdir"/usr \
		--sources-subdir=include/gnatcoll_projects \
		--build-name=relocatable --build-var=LIBRARY_TYPE

	# Dereference the versioned SONAME symlinks (libgnatcoll_projects.so.<ver>)
	# that gprinstall leaves pointing into the <build-name>/ subdirs; abuild's
	# soname tracer skips symlinks (non-recursive scanelf --soname).
	for _so in "$pkgdir"/usr/lib/*.so.*; do
		[ -L "$_so" ] || continue
		_target=$(readlink -f "$_so")
		rm -f "$_so"
		cp -a "$_target" "$_so"
	done
}

sha512sums="
5ff1892f19d627a83e7009d2c9cad10247b7730ea9ecb7f11d9c8ce2077240924512b17b4d1f32cd238ffaa499fe697ecc3d033915a25222748cf11348c6e60c  gnatcoll-358c384d11ad0d9d26d78744d3a78259c3ce0451.tar.gz
"
