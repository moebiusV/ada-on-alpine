# Maintainer: David Walther <david@clearbrookdistillery.com>
pkgname=gnatcoll
pkgver=26.0.0
pkgrel=0
pkgdesc="GNAT Components Collection core library"
url="https://github.com/AdaCore/gnatcoll-core"
arch="all"
license="GPL-3.0-or-later WITH GCC-exception-3.1"
depends="libgnat"
makedepends="gcc-gnat gprbuild xmlada build-base python3 rsync"
source="gnatcoll-$pkgver.tar.gz::https://github.com/AdaCore/gnatcoll-core/archive/refs/tags/v$pkgver.tar.gz"
builddir="$srcdir/gnatcoll-core-$pkgver"

build() {
	make prefix=/usr ENABLE_SHARED=no PROCESSORS="${JOBS:-1}" GNATCOLL_PROJECTS=no
}

check() {
	# Stage-install and compile a trivial consumer against it.
	mkdir -p "$srcdir"/stage/usr
	make prefix="$srcdir"/stage/usr ENABLE_SHARED=no GNATCOLL_PROJECTS=no install
	printf 'with Ada.Text_IO;\nprocedure Smoke is\nbegin\n   Ada.Text_IO.Put_Line ("gnatcoll ok");\nend Smoke;\n' > "$srcdir"/smoke.adb
	printf 'with "gnatcoll";\nproject Smoke is\n   for Source_Dirs use (".");\n   for Object_Dir use "obj";\n   for Exec_Dir use ".";\n   for Main use ("smoke.adb");\n   for Source_Files use ("smoke.adb");\nend Smoke;\n' > "$srcdir"/smoke.gpr
	( cd "$srcdir" && GPR_PROJECT_PATH="$srcdir"/stage/usr/share/gpr gprbuild -p -P smoke.gpr )
	[ "$("$srcdir"/smoke)" = "gnatcoll ok" ]
}

package() {
	mkdir -p "$pkgdir/usr"
	make prefix="$pkgdir/usr" ENABLE_SHARED=no GNATCOLL_PROJECTS=no install
}

sha512sums="
59a3ac4c911f1d2950964afc9ad5508a9cbd1facb0d1a49caaab8dea18376e287cbbe1948c2ae6a21de3e8488aa0b4d4a94d53f55529a909123e2db0c6c38cde  gnatcoll-26.0.0.tar.gz
"
