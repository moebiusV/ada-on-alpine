# Maintainer: David Walther <david@clearbrookdistillery.com>
pkgname=gnatcoll
pkgver=26.0.0_git20260915
pkgrel=1
_commit="358c384d11ad0d9d26d78744d3a78259c3ce0451"
pkgdesc="GNAT Components Collection core library"
url="https://github.com/AdaCore/gnatcoll-core"
arch="all"
license="GPL-3.0-or-later WITH GCC-exception-3.1"
depends="libgnat"
makedepends="gcc-gnat gprbuild xmlada build-base python3 rsync"
subpackages="$pkgname-static"
source="gnatcoll-$_commit.tar.gz::https://github.com/AdaCore/gnatcoll-core/archive/$_commit.tar.gz"
builddir="$srcdir/gnatcoll-core-$_commit"

build() {
	# ENABLE_SHARED=yes builds static, static-pic, and relocatable in one pass;
	# langkit's shared Liblktlang needs the relocatable variant.
	make ENABLE_SHARED=yes PROCESSORS="${JOBS:-1}" GNATCOLL_PROJECTS=no
}

check() {
	# Stage-install and compile a trivial consumer against it.
	mkdir -p "$srcdir"/stage/usr
	rsync -a gnatcoll-core-install/ "$srcdir"/stage/usr/
	printf 'with Ada.Text_IO;\nprocedure Smoke is\nbegin\n   Ada.Text_IO.Put_Line ("gnatcoll ok");\nend Smoke;\n' > "$srcdir"/smoke.adb
	printf 'with "gnatcoll";\nproject Smoke is\n   for Source_Dirs use (".");\n   for Object_Dir use "obj";\n   for Exec_Dir use ".";\n   for Main use ("smoke.adb");\n   for Source_Files use ("smoke.adb");\nend Smoke;\n' > "$srcdir"/smoke.gpr
	( cd "$srcdir" && GPR_PROJECT_PATH="$srcdir"/stage/usr/share/gpr gprbuild -p -P smoke.gpr )
	[ "$("$srcdir"/smoke)" = "gnatcoll ok" ]
}

package() {
	mkdir -p "$pkgdir/usr"
	# -L dereferences the lib*.so* symlinks (libgnatcoll_minimal.so.25 ->
	# .so.25.0): abuild's soname tracer needs the SONAME to be a real file.
	rsync -aL gnatcoll-core-install/ "$pkgdir/usr/"
}

sha512sums="
5ff1892f19d627a83e7009d2c9cad10247b7730ea9ecb7f11d9c8ce2077240924512b17b4d1f32cd238ffaa499fe697ecc3d033915a25222748cf11348c6e60c  gnatcoll-358c384d11ad0d9d26d78744d3a78259c3ce0451.tar.gz
"
