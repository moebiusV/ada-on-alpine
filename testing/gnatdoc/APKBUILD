# Maintainer: David Walther <david@clearbrookdistillery.com>
# NOTE: libgnatdoc.gpr is a PLAIN project upstream (no Library_Name/Kind), so
# ALS normally compiles gnatdoc's sources in-tree. This package precompiles them
# into libgnatdoc.a at package time and ships an Externally_Built project, so
# consumers link the .a instead of compiling into a shared /tmp Object_Dir. The
# standalone `gnatdoc` CLI (gnatdoc.gpr) still builds the plain project's sources
# in-tree as upstream intends, adding gpr2 + markdown + vss_xml on top (static-
# linked like ada_language_server: only libc/libgnat/libgmp stay dynamic).
pkgname=gnatdoc
pkgver=26.0.0_git20260916
pkgrel=2
_commit="b54c399c13fcc21e7ea40600674c6256170f595c"
pkgdesc="GNAT documentation generator (library + gnatdoc CLI)"
url="https://github.com/AdaCore/gnatdoc"
arch="all"
license="GPL-3.0-or-later WITH GCC-exception-3.1"
depends="libgnat gmp"
makedepends="gcc-gnat gprbuild libadalang vss vss-extra gpr ada-markdown"
source="gnatdoc-$_commit.tar.gz::https://github.com/AdaCore/gnatdoc/archive/$_commit.tar.gz"
builddir="$srcdir/gnatdoc-$_commit"

build() {
	# Standalone gnatdoc CLI: upstream's plain libgnatdoc (sources compiled
	# in-tree) plus the driver, with gpr2 + markdown + vss_xml static-linked.
	gprbuild -p -j"${JOBS:-1}" -P gnat/gnatdoc.gpr \
		-XGPR_UNIT_PROVIDER_LIBRARY_TYPE=static -XGPR_UNIT_PROVIDER_BUILD=debug \
		-XVSS_LIBRARY_TYPE=static -XMARKDOWN_LIBRARY_TYPE=static \
		-XLIBADALANG_LIBRARY_TYPE=static -XLANGKIT_SUPPORT_LIBRARY_TYPE=static \
		-XPRETTIER_ADA_LIBRARY_TYPE=static -XGPR2_LIBRARY_TYPE=static

	# Precompile libgnatdoc as a static library for downstream consumers (ALS):
	# a library-project form of gnat/libgnatdoc.gpr in its own object dir, so it
	# doesn't clash with the CLI's ../.objs. Consumers link libgnatdoc.a instead
	# of compiling the sources into a shared /tmp Object_Dir.
	mkdir -p gnat-lib
	cat > gnat-lib/libgnatdoc.gpr <<'GPR'
with "libadalang";
with "vss_regexp";
with "vss_os";
with "vss_text";

library project LibGNATdoc is
   type Library_Type_Type is ("static");
   Library_Type : Library_Type_Type := external ("LIBRARY_TYPE", "static");

   for Object_Dir use "../.objs-lib";
   for Source_Dirs use ("../source", "../source/debug");
   for Library_Name use "gnatdoc";
   for Library_Dir use "../.objs-lib/lib";
   for Library_Kind use Library_Type;

   package Compiler is
      for Switches ("Ada") use
        ("-g", "-gnat2022", "-gnatW8", "-gnatygO", "-gnata", "-gnatwa");
   end Compiler;
end LibGNATdoc;
GPR
	gprbuild -p -P gnat-lib/libgnatdoc.gpr -XLIBRARY_TYPE=static
}

check() {
	test -n "$(find "$builddir"/.objs -name '*.o' | head -1)"
	test -x "$builddir"/bin/gnatdoc
	test -f "$builddir"/share/gnatdoc/html/template/unit.xhtml
	test -n "$(find "$builddir"/.objs-lib -name 'libgnatdoc.a' | head -1)"
}

package() {
	# Install the prebuilt library (.a + .ali + sources + Externally_Built .gpr).
	gprinstall -p -f -P gnat-lib/libgnatdoc.gpr -XLIBRARY_TYPE=static \
		--prefix="$pkgdir"/usr --build-name=static --build-var=LIBRARY_TYPE

	# Install the standalone gnatdoc CLI and its rendering templates.
	install -Dm755 bin/gnatdoc "$pkgdir"/usr/bin/gnatdoc
	cp -a share/gnatdoc/. "$pkgdir"/usr/share/gnatdoc/
}

sha512sums="
8e8631f5889156ed48f75fb8eea85d20d302edf4276565c9e4c85147c1b900e9f9b01c45b5d713ded70025ef5f9fde0c7546176477a5ca26a1722d9b836753c0  gnatdoc-b54c399c13fcc21e7ea40600674c6256170f595c.tar.gz
"
