# NOTE: scaffold — build not yet validated. Blocks on langkit.
pkgname=gpr
pkgver=26.0.0
pkgrel=0
pkgdesc="GPR project-file parser library (new-generation, formerly GPR2)"
url="https://github.com/AdaCore/gpr2"
arch="all"
license="GPL-3.0-or-later WITH GCC-exception-3.1"
depends="libgnat gnatcoll"
makedepends="gcc-gnat gprbuild gnatcoll langkit python3"
source="gpr-$pkgver.tar.gz::https://github.com/AdaCore/gpr2/archive/refs/tags/v$pkgver.tar.gz"
builddir="$srcdir/gpr-$pkgver"

build() {
	make setup prefix=/usr
	make PROCESSORS="${JOBS:-1}"
}

package() {
	make install prefix="$pkgdir/usr"
}

