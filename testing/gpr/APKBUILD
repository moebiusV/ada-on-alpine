# Maintainer: David Walther <david@clearbrookdistillery.com>
# NOTE: The parser in langkit/gen is pre-generated
# (standalone, vendoring langkit_support + adasat), so langkit is not a build
# dependency; gpr2 links only gnatcoll* + xmlada.
pkgname=gpr
pkgver=26.0.0_git20260915
pkgrel=0
_commit="5763ca8090156812c5c3208ff24377cc7fd9b11f"
_kb_commit="ba383a7fa2a1ce8d27d44b00b8052acc0d49493c"
pkgdesc="GPR project-file parser library (new-generation, formerly GPR2)"
url="https://github.com/AdaCore/gpr"
arch="all"
license="Apache-2.0 WITH LLVM-exception"
depends="libgnat gnatcoll gnatcoll-gmp gnatcoll-iconv xmlada"
makedepends="gcc-gnat gprbuild gnatcoll gnatcoll-gmp gnatcoll-iconv xmlada"
source="gpr-$_commit.tar.gz::https://github.com/AdaCore/gpr/archive/$_commit.tar.gz
	gprconfig_kb-$_kb_commit.tar.gz::https://github.com/AdaCore/gprconfig_kb/archive/$_kb_commit.tar.gz"
builddir="$srcdir/gpr-$_commit"

build() {
	# Static library only (ENABLE_SHARED=no). build-libs compiles the embedded
	# knowledge base from gprconfig_kb, then libgpr2 (the pre-generated parser
	# in langkit/gen plus src/lib|build|private).
	make setup prefix=/usr ENABLE_SHARED=no GPR2_BUILD=release PROCESSORS="${JOBS:-1}"
	make build-libs GPR2KBDIR="$srcdir"/gprconfig_kb-$_kb_commit/db PROCESSORS="${JOBS:-1}"
}

check() {
	# Stage-install and verify the installed project/library layout.
	mkdir -p "$srcdir"/stage
	make install-libs prefix="$srcdir"/stage/usr
	test -f "$srcdir"/stage/usr/share/gpr/gpr2.gpr
	test -n "$(find "$srcdir"/stage/usr/lib -name 'libgpr2.a' | head -1)"
}

package() {
	make install-libs prefix="$pkgdir/usr"
}

sha512sums="
