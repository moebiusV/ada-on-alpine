pkgname=gprbuild
pkgver=26.0.0_git20260518
pkgrel=0
_commit="2781289e9e2bdc31350962211b7ef792d7d31c6f"
_xmlada_commit="9823ffb294187897a08b14bbce00743ff647cae1"
_kb_commit="ba383a7fa2a1ce8d27d44b00b8052acc0d49493c"
pkgdesc="Builder for multi-language systems"
url="https://github.com/AdaCore/gprbuild"
arch="all"
license="GPL-3.0-or-later"
depends="gcc-gnat"
makedepends="build-base which gawk"
source="gprbuild-$_commit.tar.gz::https://github.com/AdaCore/gprbuild/archive/$_commit.tar.gz
	xmlada-$_xmlada_commit.tar.gz::https://github.com/AdaCore/xmlada/archive/$_xmlada_commit.tar.gz
	gprconfig_kb-$_kb_commit.tar.gz::https://github.com/AdaCore/gprconfig_kb/archive/$_kb_commit.tar.gz
	"
builddir="$srcdir/gprbuild-$_commit"

_bootstrap() {
	GNATMAKEFLAGS="-j${JOBS:-1}" ./bootstrap.sh \
		--prefix=/usr \
		--with-xmlada="$srcdir"/xmlada-$_xmlada_commit \
		--with-kb="$srcdir"/gprconfig_kb-$_kb_commit \
		"$@"
}

build() {
	_bootstrap --build
}

check() {
	# Upstream's testsuite needs AdaCore's e3 infrastructure; smoke-test a
	# staged install instead.
	DESTDIR="$srcdir"/stage _bootstrap --install
	mkdir -p "$srcdir"/smoke && cd "$srcdir"/smoke
	printf 'project Hello is\n   for Main use ("hello.adb");\nend Hello;\n' > hello.gpr
	printf 'with Ada.Text_IO;\nprocedure Hello is\nbegin\n   Ada.Text_IO.Put_Line ("ok");\nend Hello;\n' > hello.adb
	"$srcdir"/stage/usr/bin/gprbuild -P hello.gpr
	[ "$(./hello)" = ok ]
}

package() {
	DESTDIR="$pkgdir" _bootstrap --install
}

