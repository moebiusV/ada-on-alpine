pkgname=gprbuild
pkgver=26.0.0
pkgrel=0
pkgdesc="Builder for multi-language systems"
url="https://github.com/AdaCore/gprbuild"
arch="all"
license="GPL-3.0-or-later"
depends="gcc-gnat"
makedepends="build-base which gawk"
source="gprbuild-$pkgver.tar.gz::https://github.com/AdaCore/gprbuild/archive/refs/tags/v$pkgver.tar.gz
	xmlada-$pkgver.tar.gz::https://github.com/AdaCore/xmlada/archive/refs/tags/v$pkgver.tar.gz
	gprconfig_kb-$pkgver.tar.gz::https://github.com/AdaCore/gprconfig_kb/archive/refs/tags/v$pkgver.tar.gz
	"

_bootstrap() {
	GNATMAKEFLAGS="-j${JOBS:-1}" ./bootstrap.sh \
		--prefix=/usr \
		--with-xmlada="$srcdir"/xmlada-$pkgver \
		--with-kb="$srcdir"/gprconfig_kb-$pkgver \
		"$@"
}

build() {
	_bootstrap --build
}

check() {
	# Upstream's testsuite needs AdaCore's e3 infrastructure; smoke-test a
	# staged install instead.
	DESTDIR="$srcdir"/stage _bootstrap --install
	mkdir -p "$srcdir"/smoke && cd "$srcdir"/smoke
	printf 'project Hello is\n   for Main use ("hello.adb");\nend Hello;\n' > hello.gpr
	printf 'with Ada.Text_IO;\nprocedure Hello is\nbegin\n   Ada.Text_IO.Put_Line ("ok");\nend Hello;\n' > hello.adb
	"$srcdir"/stage/usr/bin/gprbuild -P hello.gpr
	[ "$(./hello)" = ok ]
}

package() {
	DESTDIR="$pkgdir" _bootstrap --install
}

