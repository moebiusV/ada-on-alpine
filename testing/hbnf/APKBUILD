# Maintainer: David Walther <david@clearbrookdistillery.com>
pkgname=hbnf
pkgver=0.7.0_git20261022
pkgrel=0
_commit="cd94a1621dcca5946522e29e454bea132f33e16c"
pkgdesc="ABNF-style parser generator / compiler compiler (C/Ada/Rust/Zig), in Ada"
url="https://github.com/moebiusV/hbnf"
# Pure Ada, no 128-bit types (the old hbnf_config reader, whose 38-digit Decimal
# needed them, is gone), so it builds on every architecture.
arch="all"
license="ISC"
# Static-only (sources + static .a files + .gpr files): the hbnf binary is
# fully static, so the CLI itself has no runtime component.  But the installed
# libhbnf.gpr does `with "mustache.gpr"` (the code templates are rendered by
# mustache-ada), so consumers of libhbnf.a need mustache-ada installed too.
# hbnf is its own dev package (no -dev split); it ships one library,
# libhbnf.a: the schema engine and the C/Rust/Zig/Ada emitters.
depends="mustache-ada"
makedepends="gcc-gnat gprbuild build-base mustache-ada"
source="$pkgname-$_commit.tar.gz::https://github.com/moebiusV/$pkgname/archive/$_commit.tar.gz"
builddir="$srcdir/$pkgname-$_commit"

build() {
	gprbuild -P libhbnf.gpr -p -XLIBRARY_TYPE=static
	# hbnf links -static (see hbnf.gpr) so the shipped binary runs on glibc and
	# musl alike. gprbuild emits -lgnat-15/-lgnarl-15 (versioned), but Alpine
	# ships the static runtime unversioned as libgnat.a/libgnarl.a.  Provide
	# the versioned names as symlinks in a writable dir (abuild's build user
	# cannot write into the root-owned adalib/) and point the linker at it with
	# -L (LIBRARY_PATH is ignored by a cross compiler).
	ADALIB="$(gcc -print-file-name=adalib)"
	GNAT_MAJOR="$(gcc -dumpversion | cut -d. -f1)"
	linklib="$srcdir/.linklibs"
	mkdir -p "$linklib"
	ln -sf "$ADALIB/libgnat.a"  "$linklib/libgnat-$GNAT_MAJOR.a"
	ln -sf "$ADALIB/libgnarl.a" "$linklib/libgnarl-$GNAT_MAJOR.a"
	gprbuild -P hbnf.gpr -p -XLIBRARY_TYPE=static -largs -L"$linklib"
}

check() {
	# hbnf_emit_check: the C/Ada emitters against the schema grammar.
	gprbuild -P tests/check.gpr -p
	./tests/hbnf_emit_check tests/server.hbnf hbnf_schema.hbnf

	# The schema grammar (tests/accept and tests/reject) and the portable
	# grammar through the backends this builder has compilers for: C and Ada.
	# (Rust and Zig need rustc and zig; upstream runs all four.)
	export HBNF=./hbnf HBNF_TEMPLATES="$PWD/templates"
	SCHEMA_BACKENDS="c ada" sh tests/schema.sh
	sh tests/portable.sh

	# The CLI emits a self-contained C parser; smoke-test that it compiles.
	# Generate into a mktemp dir (the djb dance) rather than a fixed /tmp
	# path, so two concurrent builds can't collide.
	tmpdir=$(mktemp -d)
	trap 'rm -rf "$tmpdir"' EXIT
	./hbnf tests/server.hbnf --backend=c --templates=templates > "$tmpdir/hbnf-out.c"
	cc -std=gnu11 -D_GNU_SOURCE -c "$tmpdir/hbnf-out.c" -o "$tmpdir/hbnf-out.o"
}

package() {
	gprinstall -P libhbnf.gpr -p --prefix="$pkgdir/usr" \
		--sources-subdir=include/hbnf
	install -Dm755 hbnf "$pkgdir/usr/bin/hbnf"
	# The code-generator templates: loaded at runtime from the XDG data
	# dir (--templates=DIR or $HBNF_TEMPLATES to override).
	install -d "$pkgdir/usr/share/hbnf"
	install -m644 templates/*.tmpl "$pkgdir/usr/share/hbnf/"
}

sha512sums="281222cf935732b46d77984d44f5fff2aede4e415915a884bb2610ffb555270b19ac85c8fef77c11ccd23d6e97163792740ca7cfd7a08562de94e26283e75b76  hbnf-cd94a1621dcca5946522e29e454bea132f33e16c.tar.gz"
