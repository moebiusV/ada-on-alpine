# Maintainer: David Walther <david@clearbrookdistillery.com>
pkgname=hbnf
pkgver=0.1.0
pkgrel=0
_commit="73014af131dc106f3c556a08c7eeedb137e9b410"
pkgdesc="OpenBSD-style configuration file parser in Ada"
url="https://github.com/moebiusV/ada-on-alpine"
arch="all"
license="ISC"
# Static-only (sources + a static .a + a .gpr): no runtime component, so no
# runtime depends and no -dev split — hbnf is its own dev package.
makedepends="gcc-gnat gprbuild build-base"
# The parser source lives in this same repo (sources/hbnf/); pull it from the
# pinned tarball rather than vendoring the files into the aport dir.
source="ada-on-alpine-$_commit.tar.gz::https://github.com/moebiusV/ada-on-alpine/archive/$_commit.tar.gz"
builddir="$srcdir/ada-on-alpine-$_commit/sources/hbnf"

build() {
	gprbuild -P hbnf.gpr -p -XLIBRARY_TYPE=static
}

check() {
	# Build the conformance driver against the built library and run the
	# corpus: every accept/*.conf must parse and round-trip (print, re-parse,
	# re-print is stable), every reject/*.conf must fail.
	gprbuild -P tests/check.gpr -p
	for f in tests/accept/*.conf; do
		./tests/hbnf_check "$f" accept
	done
	for f in tests/reject/*.conf; do
		./tests/hbnf_check "$f" reject
	done
}

package() {
	gprinstall -P hbnf.gpr -p --prefix="$pkgdir/usr" \
		--sources-subdir=include/hbnf
}

sha512sums="41049e40f0b2124135c7230c5345e7ce08695777620e8790d2d3bbaa700b87583d5b267409aac2dedd8aff6d8ff403327b1c7745ff0a8e2ac54f739868718b49  ada-on-alpine-$_commit.tar.gz"
