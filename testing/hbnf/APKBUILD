# Maintainer: David Walther <david@clearbrookdistillery.com>
pkgname=hbnf
pkgver=0.1.0
pkgrel=0
_commit="PENDING-commit"  # filled after the sources are pushed; see build notes
pkgdesc="OpenBSD-style (Hartmeier Brauer Norby Floeter) configuration parser"
url="https://github.com/moebiusV/ada-on-alpine"
arch="all"
license="ISC"
depends="libgnat"
makedepends="gcc-gnat gprbuild build-base"
# The parser source lives in this same repo (sources/hbnf/); pull it from the
# pinned tarball rather than vendoring the files into the aport dir.
source="ada-on-alpine-$_commit.tar.gz::https://github.com/moebiusV/ada-on-alpine/archive/$_commit.tar.gz"
builddir="$srcdir/ada-on-alpine-$_commit/sources/hbnf"

build() {
	gprbuild -P hbnf.gpr -p -XLIBRARY_TYPE=static
}

check() {
	mkdir -p "$srcdir"/stage
	gprinstall -P hbnf.gpr -p --prefix="$srcdir"/stage/usr \
		--sources-subdir=include/hbnf
	test -f "$srcdir"/stage/usr/share/gpr/hbnf.gpr
	test -f "$srcdir"/stage/usr/include/hbnf/hbnf.ads
}

package() {
	gprinstall -P hbnf.gpr -p --prefix="$pkgdir/usr" \
		--sources-subdir=include/hbnf
}

sha512sums="PENDING-abuild-checksum"
