# Maintainer: David Walther <david@clearbrookdistillery.com>
pkgname=hbnf
pkgver=0.5.0
pkgrel=0
_tag="hbnf-v$pkgver"
pkgdesc="OpenBSD-style config parser + ABNF schema engine (C/Ada/Rust/Zig parser generators) in Ada"
url="https://github.com/moebiusV/ada-on-alpine"
arch="all"
license="ISC"
# Static-only (sources + static .a files + .gpr files): no runtime component,
# so no runtime depends and no -dev split — hbnf is its own dev package.  It
# ships one library, libhbnf.a: the config parser plus the schema engine and
# the C/Rust/Zig/Ada emitters.
makedepends="gcc-gnat gprbuild build-base"
# The sources live in THIS repo (sources/hbnf/), so the tarball is
# self-referential. Pin it to a version tag, never a commit hash (a rewritten
# history breaks a hash pin). To release: `git tag hbnf-v$pkgver`, push the
# commit and the tag, then `abuild checksum` and commit the new sha512sums.
source="ada-on-alpine-$_tag.tar.gz::https://github.com/moebiusV/ada-on-alpine/archive/refs/tags/$_tag.tar.gz"
builddir="$srcdir/ada-on-alpine-$_tag/sources/hbnf"

build() {
	gprbuild -P hbnf.gpr -p -XLIBRARY_TYPE=static
	gprbuild -P hbnf_cli.gpr -p -XLIBRARY_TYPE=static
}

check() {
	# Build the conformance drivers against the built library and run them:
	# hbnf_check (every accept/*.conf parses and round-trips, every reject
	# fails), hbnf_match_check (the hbnf binder agrees with hbnf's own
	# parser on the whole corpus), and hbnf_emit_check (the C/Ada emitters).
	gprbuild -P tests/check.gpr -p
	for f in tests/accept/*.conf; do
		./tests/hbnf_check "$f" accept
	done
	for f in tests/reject/*.conf; do
		./tests/hbnf_check "$f" reject
	done
	for f in tests/accept/*.conf; do
		./tests/hbnf_match_check ./hbnf_schema.hbnf "$f" accept
	done
	for f in tests/reject/*.conf; do
		./tests/hbnf_match_check ./hbnf_schema.hbnf "$f" reject
	done
	./tests/hbnf_emit_check tests/server.hbnf hbnf_schema.hbnf

	# The CLI emits a self-contained C parser; smoke-test that it compiles.
	# Generate into a mktemp dir (the djb dance) rather than a fixed /tmp
	# path, so two concurrent builds can't collide.
	tmpdir=$(mktemp -d)
	trap 'rm -rf "$tmpdir"' EXIT
	./hbnf_cli tests/server.hbnf --backend=c > "$tmpdir/hbnf-out.c"
	cc -std=gnu11 -D_GNU_SOURCE -c "$tmpdir/hbnf-out.c" -o "$tmpdir/hbnf-out.o"
}

package() {
	gprinstall -P hbnf.gpr -p --prefix="$pkgdir/usr" \
		--sources-subdir=include/hbnf
	install -Dm755 hbnf_cli "$pkgdir/usr/bin/hbnf"
}

sha512sums="0eb5224da2f919e48d9edfff7723b118986a01e8bccc9301d4bae0204d01d327e7f6aea80f836a9460b520bc1a6b587361af42780972146954f8b907b3568b5a  ada-on-alpine-$_tag.tar.gz"
