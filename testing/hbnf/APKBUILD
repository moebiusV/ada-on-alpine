# Maintainer: David Walther <david@clearbrookdistillery.com>
pkgname=hbnf
pkgver=0.2.0
pkgrel=0
_tag="hbnf-v$pkgver"
pkgdesc="OpenBSD-style configuration file parser in Ada"
url="https://github.com/moebiusV/ada-on-alpine"
arch="all"
license="ISC"
# Static-only (sources + a static .a + a .gpr): no runtime component, so no
# runtime depends and no -dev split — hbnf is its own dev package.  It does
# depend on astbnf (hbnf.gpr withs it), so consumers get that .gpr too.
makedepends="gcc-gnat gprbuild build-base astbnf"
depends="astbnf"
# The parser source lives in THIS repo (sources/hbnf/), so the tarball is
# self-referential. Pin it to a version tag, never a commit hash (a rewritten
# history breaks a hash pin). To release: `git tag hbnf-v$pkgver`, push the
# commit and the tag, then `abuild checksum` and commit the new sha512sums.
source="ada-on-alpine-$_tag.tar.gz::https://github.com/moebiusV/ada-on-alpine/archive/refs/tags/$_tag.tar.gz"
builddir="$srcdir/ada-on-alpine-$_tag/sources/hbnf"

build() {
	gprbuild -P hbnf.gpr -p -XLIBRARY_TYPE=static
}

check() {
	# Build the conformance driver against the built library and run the
	# corpus: every accept/*.conf must parse and round-trip (print, re-parse,
	# re-print is stable), every reject/*.conf must fail.
	gprbuild -P tests/check.gpr -p
	for f in tests/accept/*.conf; do
		./tests/hbnf_check "$f" accept
	done
	for f in tests/reject/*.conf; do
		./tests/hbnf_check "$f" reject
	done
}

package() {
	gprinstall -P hbnf.gpr -p --prefix="$pkgdir/usr" \
		--sources-subdir=include/hbnf
}

sha512sums="463296f8de70a145fc308a3192b66510ce68905306aea275de9d7c9be6d2f059fb7ff6019b741cc34be87ebf78d5b1eb47d033c87beda53cd8c08c0b93426d9f  ada-on-alpine-$_tag.tar.gz"
