# Maintainer: David Walther <david@clearbrookdistillery.com>
pkgname=imsg-ada
pkgver=0.3.4
pkgrel=0
_tag="imsg-ada-v$pkgver"
pkgdesc="OpenBSD imsg message-passing protocol (portable imsg.c wire format) in Ada"
url="https://github.com/moebiusV/ada-on-alpine"
arch="all"
license="ISC"
# Static + relocatable: the .a ships in the -static subpackage, the .so in the
# main package. Pure Ada on the GNAT runtime: no C dependencies, no external
# GPR projects.
depends="libgnat"
makedepends="gcc-gnat gprbuild build-base"
# The sources live in THIS repo (sources/imsg-ada/), so the tarball is
# self-referential. Pin it to a version tag, never a commit hash (a rewritten
# history breaks a hash pin). To release: `git tag imsg-ada-v$pkgver`, push the
# commit and the tag, then `abuild checksum` and commit the new sha512sums.
source="ada-on-alpine-$_tag.tar.gz::https://github.com/moebiusV/ada-on-alpine/archive/refs/tags/$_tag.tar.gz"
builddir="$srcdir/ada-on-alpine-$_tag/sources/imsg-ada"
subpackages="$pkgname-static"

build() {
	# Relocatable first: imsg.gpr doesn't split its object dir by Library_Type,
	# so build the shared lib first (-fPIC objects) and let the static archive
	# reuse them (PIC objects are valid in a .a; the reverse fails the .so link).
	gprbuild -P imsg.gpr -p -XLIBRARY_TYPE=relocatable
	gprbuild -P imsg.gpr -p -XLIBRARY_TYPE=static
}

check() {
	gprbuild -P tests/check.gpr -p
	./tests/imsg_check

	# C <-> Ada interop: a C harness hand-rolls one frame exactly as portable
	# imsg.c's imsg_compose does and writes it to stdout; the Ada c_interop
	# decodes it, proving the two sides agree byte-for-byte.
	gprbuild -P tests/c_interop.gpr -p
	cc -o tests/c_compose tests/c_compose.c
	./tests/c_compose > tests/c_frame.bin
	./tests/c_interop tests/c_frame.bin
}

package() {
	gprinstall -P imsg.gpr -p -f -XLIBRARY_TYPE=static \
		--prefix="$pkgdir/usr" --sources-subdir=include/imsg \
		--build-name=static --build-var=LIBRARY_TYPE
	gprinstall -P imsg.gpr -p -f -XLIBRARY_TYPE=relocatable \
		--prefix="$pkgdir/usr" --sources-subdir=include/imsg \
		--build-name=relocatable --build-var=LIBRARY_TYPE
}

sha512sums="
99aa8d0d7f3bc29af954df0721e4ce52dbe9c95b927c138d01d338fbe082661f4c7d89d948a1d5fc572ec28a0f2d186e6e7b61d83b14964af8707a7d956411de    ada-on-alpine-imsg-ada-v0.3.4.tar.gz
"
