# Maintainer: David Walther <david@clearbrookdistillery.com>
pkgname=imsg
pkgver=0.1.0
pkgrel=0
_tag="imsg-v$pkgver"
pkgdesc="OpenBSD imsg message-passing protocol (portable imsg.c wire format) in Ada"
url="https://github.com/moebiusV/ada-on-alpine"
arch="all"
license="ISC"
# Static-only (sources + static .a + .gpr): no runtime component, so no
# runtime depends and no -dev split -- imsg is its own dev package.  Pure
# Ada on the GNAT runtime: no C dependencies, no external GPR projects.
makedepends="gcc-gnat gprbuild build-base"
# The sources live in THIS repo (sources/imsg/), so the tarball is
# self-referential. Pin it to a version tag, never a commit hash (a rewritten
# history breaks a hash pin). To release: `git tag imsg-v$pkgver`, push the
# commit and the tag, then `abuild checksum` and commit the new sha512sums.
source="ada-on-alpine-$_tag.tar.gz::https://github.com/moebiusV/ada-on-alpine/archive/refs/tags/$_tag.tar.gz"
builddir="$srcdir/ada-on-alpine-$_tag/sources/imsg"

build() {
	gprbuild -P imsg.gpr -p -XLIBRARY_TYPE=static
}

check() {
	gprbuild -P tests/check.gpr -p
	./tests/imsg_check
}

package() {
	gprinstall -P imsg.gpr -p --prefix="$pkgdir/usr" \
		--sources-subdir=include/imsg
}

sha512sums="SKIP"
