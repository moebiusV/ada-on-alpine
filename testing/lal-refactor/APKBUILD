# Maintainer: David Walther <david@clearbrookdistillery.com>
# NOTE: Library_Name is "lal-refactor"
# (liblal-refactor.a). Needs vss_os from the vss-extra package. Pinned to the
# `main` branch (default `edge` is stale, May 2026) so it matches libadalang-tools'
# Move_Arguments_Callback API (the mr/beguet/lal_1733 change).
pkgname=lal-refactor
pkgver=26.0.0_git20260821
pkgrel=0
_commit="0f197d1968fb6bea174da7335c8aeeed0144c07a"
pkgdesc="Ada source-code refactoring library"
url="https://github.com/AdaCore/lal-refactor"
arch="all"
license="Apache-2.0 WITH LLVM-exception"
depends="libgnat libadalang-tools vss vss-extra"
makedepends="gcc-gnat gprbuild libadalang-tools vss vss-extra"
source="lal-refactor-$_commit.tar.gz::https://github.com/AdaCore/lal-refactor/archive/$_commit.tar.gz"
builddir="$srcdir/lal-refactor-$_commit"

build() {
	gprbuild -p -P gnat/lal_refactor.gpr -XLAL_REFACTOR_LIBRARY_TYPE=static -XLAL_REFACTOR_BUILD_MODE=prod
}

check() {
	# Stage-install and verify the installed project/library layout.
	mkdir -p "$srcdir"/stage
	gprinstall -p -f -P gnat/lal_refactor.gpr -XLAL_REFACTOR_LIBRARY_TYPE=static -XLAL_REFACTOR_BUILD_MODE=prod \
		--prefix="$srcdir"/stage/usr --build-name=static --build-var=LIBRARY_TYPE
	test -f "$srcdir"/stage/usr/share/gpr/lal_refactor.gpr
	test -n "$(find "$srcdir"/stage/usr/lib -name 'liblal-refactor.a' | head -1)"
}

package() {
	gprinstall -p -f -P gnat/lal_refactor.gpr -XLAL_REFACTOR_LIBRARY_TYPE=static -XLAL_REFACTOR_BUILD_MODE=prod \
		--prefix="$pkgdir"/usr --build-name=static --build-var=LIBRARY_TYPE
}

sha512sums="
c26d25fbaf8815433432755d1802683ab8ab2c2987790e5c34c042f77635cf7f79fa8da6ce39a62bf3c02a32d004272fc2401378a6b1a742e97a5c3233cfe765  lal-refactor-0f197d1968fb6bea174da7335c8aeeed0144c07a.tar.gz
"
