# Maintainer: David Walther <david@clearbrookdistillery.com>
# NOTE: scaffold — build not yet validated. langkit is a self-hosting
# parser-generator framework: a Python toolchain (manage.py / pyproject)
# plus an Ada runtime. Needs py3-e3-core, py3-mako, and a bootstrap of the
# LKT language before the library/compiler can be produced.
pkgname=langkit
pkgver=26.0.0_git20260915
pkgrel=0
_commit="537d30227cbc46f28de59a933ba4570e074cbf98"
pkgdesc="Language analysis and generation framework (compiler + runtime)"
url="https://github.com/AdaCore/langkit"
arch="all"
license="GPL-3.0-or-later WITH GCC-exception-3.1"
depends="libgnat"
makedepends="gcc-gnat gprbuild python3 py3-setuptools"
source="langkit-$_commit.tar.gz::https://github.com/AdaCore/langkit/archive/$_commit.tar.gz"
builddir="$srcdir/langkit-$_commit"

build() {
	# TODO: real build is the AdaCore manage.py flow (Python install + Ada
	# support library + LKT bootstrap). To be fleshed out during validation.
	python3 -m build --wheel --no-isolation 2>/dev/null || true
}

package() {
	mkdir -p "$pkgdir"
}

