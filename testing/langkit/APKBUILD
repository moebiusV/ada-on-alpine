# Maintainer: David Walther <david@clearbrookdistillery.com>
# NOTE: langkit is
# a self-hosting parser-generator: a Python toolchain (py3-langkit) plus an Ada
# runtime (Langkit_Support) and the Liblktlang parser library, generated from
# the checked-in LKT bootstrap. The ctypes Python bindings force a shared
# (relocatable) Liblktlang, so every Ada dependency below ships static AND
# relocatable.
pkgname=langkit
pkgver=26.0.0_git20260915
pkgrel=0
_commit="537d30227cbc46f28de59a933ba4570e074cbf98"
pkgdesc="Language analysis and generation framework (Ada runtime + Liblktlang)"
url="https://github.com/AdaCore/langkit"
arch="all"
license="Apache-2.0 WITH LLVM-exception"
depends="libgnat gnatcoll"
makedepends="gcc-gnat gprbuild py3-pip py3-langkit adasat gnatcoll gnatcoll-gmp gnatcoll-iconv prettier-ada"
checkdepends="py3-e3-core py3-e3-testsuite"
source="langkit-$_commit.tar.gz::https://github.com/AdaCore/langkit/archive/$_commit.tar.gz"
builddir="$srcdir/langkit-$_commit"

build() {
	# langkit's emitter.py needs the AdaSAT sources at langkit/adasat/src (a
	# git submodule omitted from the GitHub tarball). Populate that exact path
	# from the installed adasat package; leave GPR_PROJECT_PATH alone so
	# gprbuild keeps resolving "adasat" through /usr/share/gpr.
	mkdir -p langkit/adasat/src
	cp /usr/include/adasat/*.ad[sb] langkit/adasat/src/

	# Build Langkit_Support and Liblktlang (static + relocatable). The
	# bootstrap Liblktlang is generated from the checked-in LKT bootstrap, so
	# no pre-existing langkit is required. Skip mypy (dev-only typecheck).
	python3 manage.py make --no-mypy \
		--library-types=static,relocatable \
		-j"${JOBS:-1}"
}

check() {
	# Stage-install and verify the installed project/library layout.
	python3 manage.py install-langkit-support \
		"$srcdir"/stage/usr --library-types=static,relocatable
	test -f "$srcdir"/stage/usr/share/gpr/langkit_support.gpr
	test -n "$(find "$srcdir"/stage/usr/lib -name 'liblangkit_support.a' | head -1)"
	# Use langkit's own environment setup to expose the built Liblktlang
	# (Python bindings, shared lib, lkt_* mains) to the testsuite — the
	# canonical `eval $(manage.py printenv)` from the langkit dev workflow.
	eval "$(python3 manage.py printenv)"
	# Run the LKT-language tests (a fast subset of the upstream e3-testsuite)
	# to exercise Liblktlang and its Python bindings. Pass the full tests/
	# path: a bare "lkt" would match the top-level lkt/ source directory
	# (e3-testsuite treats an existing directory argument as the root).
	python3 testsuite/testsuite.py \
		--disable-java --disable-ocaml --disable-native-image \
		-j"${JOBS:-1}" testsuite/tests/lkt
}

package() {
	python3 manage.py install-langkit-support \
		"$pkgdir/usr" --library-types=static,relocatable
	python3 -m langkit.scripts.lkm install \
		-c lkt/langkit.yaml "$pkgdir/usr" \
		--library-types=static,relocatable --disable-all-mains
	# The generated LKT ctypes bindings (lkt/build/python) are what `lkm` uses
	# to parse .lkt specs when building libadalang/gpr downstream. Install them
	# alongside the shared library.
	python3 -m pip install --prefix="$pkgdir/usr" --no-deps lkt/build/python
}

sha512sums="
