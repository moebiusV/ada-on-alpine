# Maintainer: David Walther <david@clearbrookdistillery.com>
# NOTE: Installs liblal_tools (project
# lal_tools.gpr) plus the executable tools gnatpp/gnatmetric/gnatstub (project
# src/build.gpr); lal_tools.gpr Excluded_Source_Files the tool mains, so they
# are built separately. Depends on libadalang + the standalone templates-parser
# package (aws does not install it).
pkgname=libadalang-tools
pkgver=26.0.0_git20260916
pkgrel=1
_commit="282af1931ccba08efbb45de29e6345cd873e1b25"
pkgdesc="Libadalang tools: gnatpp, gnatmetric, gnatstub + libraries"
url="https://github.com/AdaCore/libadalang-tools"
arch="all"
license="GPL-3.0-or-later WITH GCC-exception-3.1"
depends="libgnat libadalang templates-parser vss"
makedepends="gcc-gnat gprbuild libadalang templates-parser vss vss-static"
source="libadalang-tools-$_commit.tar.gz::https://github.com/AdaCore/libadalang-tools/archive/$_commit.tar.gz"
builddir="$srcdir/libadalang-tools-$_commit"

build() {
	gprbuild -p -P src/lal_tools.gpr -XLIBRARY_TYPE=static
	# The executable tools are separate mains in src/build.gpr (gnatpp,
	# gnatmetric, gnatstub); build them against the same static/dev scenario
	# as the library above. -j1 keeps the three large static links serial.
	gprbuild -p -P src/build.gpr -XLIBRARY_TYPE=static -XXMLADA_BUILD=static \
		-XLALTOOLS_SET=all -j"${JOBS:-1}"
}

check() {
	# Stage-install and verify the installed project/library layout.
	mkdir -p "$srcdir"/stage
	gprinstall -p -f -P src/lal_tools.gpr -XLIBRARY_TYPE=static \
		--prefix="$srcdir"/stage/usr --build-name=static --build-var=LIBRARY_TYPE
	test -f "$srcdir"/stage/usr/share/gpr/lal_tools.gpr
	test -n "$(find "$srcdir"/stage/usr/lib -name 'liblal_tools.a' | head -1)"
}

package() {
	gprinstall -p -f -P src/lal_tools.gpr -XLIBRARY_TYPE=static \
		--prefix="$pkgdir"/usr --build-name=static --build-var=LIBRARY_TYPE
	# Ship the three user-facing tools (skip utils-var_length_ints-test, the
	# repo's internal test binary that build.gpr also produces).
	install -d "$pkgdir"/usr/bin
	install -m755 bin/gnatpp bin/gnatmetric bin/gnatstub "$pkgdir"/usr/bin/
}

sha512sums="
71df58738f70bffd572e30bf081dd82579196c328c98332cb9e690a8db978ef73ea9d44c42cf9307cedf5750950493c20475d874f5d9304ca49396d3d02d801a  libadalang-tools-282af1931ccba08efbb45de29e6345cd873e1b25.tar.gz
"
