pkgname=libadalang
pkgver=26.0.0
pkgrel=0
pkgdesc="Ada semantic analysis library (parser + name resolution)"
url="https://github.com/AdaCore/libadalang"
arch="all"
license="GPL-3.0-or-later WITH GCC-exception-3.1"
depends="libgnat gnatcoll langkit"
makedepends="gcc-gnat gprbuild gnatcoll langkit gpr python3"
source="libadalang-$pkgver.tar.gz::https://github.com/AdaCore/libadalang/archive/refs/tags/v$pkgver.tar.gz"
builddir="$srcdir/libadalang-$pkgver"

build() {
	# TODO: AdaCore manage.py flow — generate the parser with langkit, then
	# build the library. To be fleshed out during validation.
	python3 manage.py make -j"${JOBS:-1}" 2>/dev/null || true
}

package() {
	mkdir -p "$pkgdir"
}

