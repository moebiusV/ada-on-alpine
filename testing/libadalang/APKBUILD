# Maintainer: David Walther <david@clearbrookdistillery.com>
# NOTE: The parser is generated by langkit (lkm) at
# build time; libadalang is not "standalone", so it links langkit_support and
# needs gnatcoll-projects + gpr (GPR2) alongside gnatcoll core/gmp/iconv.
# The generated parser units (libadalang-impl_0/1/2.adb) are ~2 GB each to
# compile, so a parallel build (JOBS>1) OOMs below ~8 GB of RAM. Build with
# -j"${JOBS:-1}" so a low-RAM builder falls back to one unit at a time.
pkgname=libadalang
pkgver=26.0.0_git20260911
pkgrel=2
_commit="69d7b688345ebc5139620cf3dee5bcbd473a9d28"
pkgdesc="Ada semantic analysis library (parser + name resolution)"
url="https://github.com/AdaCore/libadalang"
arch="all"
license="Apache-2.0 WITH LLVM-exception"
depends="libgnat langkit gnatcoll gnatcoll-gmp gnatcoll-iconv gnatcoll-projects gpr"
makedepends="gcc-gnat gprbuild py3-langkit langkit langkit-static gnatcoll gnatcoll-static gnatcoll-gmp gnatcoll-gmp-static gnatcoll-iconv gnatcoll-iconv-static gnatcoll-projects gpr"
source="libadalang-$_commit.tar.gz::https://github.com/AdaCore/libadalang/archive/$_commit.tar.gz"
builddir="$srcdir/libadalang-$_commit"

build() {
	# Generate the parser from the LKT spec and build libadalang (static).
	python3 -m langkit.scripts.lkm make --library-types=static -j"${JOBS:-1}"
}

check() {
	# Stage-install and verify the installed project/library layout.
	python3 -m langkit.scripts.lkm install \
		"$srcdir"/stage/usr --library-types=static --disable-all-mains
	test -f "$srcdir"/stage/usr/share/gpr/libadalang.gpr
	test -n "$(find "$srcdir"/stage/usr/lib -name 'libadalang.a' | head -1)"
}

package() {
	python3 -m langkit.scripts.lkm install \
		"$pkgdir"/usr --library-types=static
	# Drop the gprinstall uninstall-manifest for the generic "mains" project:
	# langkit ships the same-named manifest, and apk owns uninstall here.
	rm -f "$pkgdir"/usr/share/gpr/manifests/mains
	# langkit already ships the shared binding skeletons (java/ocaml/python);
	# libadalang's copies collide with them and are not needed by Ada consumers.
	rm -rf "$pkgdir"/usr/java "$pkgdir"/usr/ocaml "$pkgdir"/usr/python
	# Keep the user-facing debug mains (lal_parse, lal_unparse) but drop the
	# seven internal testsuite harness mains that `lkm install` also places in
	# /usr/bin (check_ambiguity, gnat_compare, incrementality, lal_dda,
	# lal_prep, nameres, navigate).
	rm -f "$pkgdir"/usr/bin/check_ambiguity "$pkgdir"/usr/bin/gnat_compare \
		"$pkgdir"/usr/bin/incrementality "$pkgdir"/usr/bin/lal_dda \
		"$pkgdir"/usr/bin/lal_prep "$pkgdir"/usr/bin/nameres \
		"$pkgdir"/usr/bin/navigate
}

sha512sums="
0144e1c86492556f4fe14091d81351ebd0882a6070353cc4643e182666c3f9a6dd10c1c72d83bc14a9b3aa6f75ee2197919d8ad22c479a0b4da6cd60aa01e509  libadalang-69d7b688345ebc5139620cf3dee5bcbd473a9d28.tar.gz
"
