# Maintainer: David Walther <david@clearbrookdistillery.com>
pkgname=libsodium-ada
pkgver=0.2.0
pkgrel=0
_tag="libsodium-ada-v$pkgver"
pkgdesc="Complete thin Ada binding to libsodium (randombytes, SHA-2, HMAC, AEAD, base64/hex, secure memory, and the full symmetric/asymmetric suites)"
url="https://github.com/moebiusV/ada-on-alpine"
arch="all"
license="ISC"
depends="libgnat libsodium"
makedepends="gcc-gnat gprbuild build-base libsodium-dev"
# The binding source lives in THIS repo (sources/libsodium-ada/), so the
# tarball is self-referential. Pin it to a version tag, never a commit hash (a
# rewritten history breaks a hash pin). To release:
# `git tag libsodium-ada-v$pkgver`, push the commit and the tag, then
# `abuild checksum` and commit the new sha512sums.
source="ada-on-alpine-$_tag.tar.gz::https://github.com/moebiusV/ada-on-alpine/archive/refs/tags/$_tag.tar.gz"
builddir="$srcdir/ada-on-alpine-$_tag/sources/libsodium-ada"
subpackages="$pkgname-static"

build() {
	# Relocatable first: crypto.gpr doesn't split its object dir by Library_Type,
	# so build the shared lib first (-fPIC objects) and let the static archive
	# reuse them (PIC objects are valid in a .a; the reverse fails the .so link).
	gprbuild -P crypto.gpr -p -XLIBRARY_TYPE=relocatable
	gprbuild -P crypto.gpr -p -XLIBRARY_TYPE=static
}

check() {
	mkdir -p "$srcdir"/stage
	gprinstall -P crypto.gpr -p -f -XLIBRARY_TYPE=static \
		--prefix="$srcdir"/stage/usr --sources-subdir=include/crypto \
		--build-name=static --build-var=LIBRARY_TYPE
	test -f "$srcdir"/stage/usr/share/gpr/crypto.gpr
	test -n "$(find "$srcdir"/stage/usr/lib -name 'libcrypto_ada.a' | head -1)"
}

package() {
	gprinstall -P crypto.gpr -p -f -XLIBRARY_TYPE=static \
		--prefix="$pkgdir/usr" --sources-subdir=include/crypto \
		--build-name=static --build-var=LIBRARY_TYPE
	gprinstall -P crypto.gpr -p -f -XLIBRARY_TYPE=relocatable \
		--prefix="$pkgdir/usr" --sources-subdir=include/crypto \
		--build-name=relocatable --build-var=LIBRARY_TYPE
	install -D -m644 "$builddir"/libsodium-ada.3 \
		"$pkgdir"/usr/share/man/man3/libsodium-ada.3
}

sha512sums="81acef2f9804116d884970d0e6026a250bb898673e867ed97d71be035704999c762e46bed37951aa35a5dedad02683b02cd91c3bf150f7c1735c50d05f3f54b9  ada-on-alpine-$_tag.tar.gz"
