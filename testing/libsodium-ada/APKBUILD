# Maintainer: David Walther <david@clearbrookdistillery.com>
pkgname=libsodium-ada
pkgver=0.1.0
pkgrel=0
_tag="libsodium-ada-v$pkgver"
pkgdesc="Thin Ada binding to libsodium: ChaCha20-Poly1305 AEAD, HMAC-SHA256, randombytes"
url="https://github.com/moebiusV/ada-on-alpine"
arch="all"
license="ISC"
depends="libsodium"
makedepends="gcc-gnat gprbuild build-base libsodium-dev"
# The binding source lives in THIS repo (sources/libsodium-ada/), so the
# tarball is self-referential. Pin it to a version tag, never a commit hash (a
# rewritten history breaks a hash pin). To release:
# `git tag libsodium-ada-v$pkgver`, push the commit and the tag, then
# `abuild checksum` and commit the new sha512sums.
source="ada-on-alpine-$_tag.tar.gz::https://github.com/moebiusV/ada-on-alpine/archive/refs/tags/$_tag.tar.gz"
builddir="$srcdir/ada-on-alpine-$_tag/sources/libsodium-ada"

build() {
	gprbuild -P crypto.gpr -p -XLIBRARY_TYPE=static
}

check() {
	mkdir -p "$srcdir"/stage
	gprinstall -P crypto.gpr -p --prefix="$srcdir"/stage/usr \
		--sources-subdir=include/crypto
	test -f "$srcdir"/stage/usr/share/gpr/crypto.gpr
	test -f "$srcdir"/stage/usr/include/crypto/crypto.ads
}

package() {
	gprinstall -P crypto.gpr -p --prefix="$pkgdir/usr" \
		--sources-subdir=include/crypto
}

sha512sums="81acef2f9804116d884970d0e6026a250bb898673e867ed97d71be035704999c762e46bed37951aa35a5dedad02683b02cd91c3bf150f7c1735c50d05f3f54b9  ada-on-alpine-$_tag.tar.gz"
