# Maintainer: David Walther <david@clearbrookdistillery.com>
pkgname=mustache-ada
pkgver=0.2.1
pkgrel=0
_tag="v$pkgver"
pkgdesc="A Mustache template engine in Ada"
url="https://github.com/moebiusV/mustache-ada"
arch="all"
license="ISC"
# Static + relocatable: the .a ships in the -static subpackage, the .so in the
# main package.  Pure Ada on the GNAT runtime: no C dependencies, no external
# GPR projects.
depends="libgnat"
makedepends="gcc-gnat gprbuild build-base"
source="$pkgname-$_tag.tar.gz::https://github.com/moebiusV/$pkgname/archive/refs/tags/$_tag.tar.gz"
builddir="$srcdir/$pkgname-$_tag"
subpackages="$pkgname-static $pkgname-doc"

build() {
	gprbuild -P mustache.gpr -p -XLIBRARY_TYPE=relocatable
	gprbuild -P mustache.gpr -p -XLIBRARY_TYPE=static
}

check() {
	gprbuild -P tests/check.gpr -p
	./tests/mustache_check
	./tests/spec_check tests/spec
}

package() {
	gprinstall -P mustache.gpr -p -f -XLIBRARY_TYPE=static \
		--prefix="$pkgdir/usr" --sources-subdir=include/mustache \
		--build-name=static --build-var=LIBRARY_TYPE
	gprinstall -P mustache.gpr -p -f -XLIBRARY_TYPE=relocatable \
		--prefix="$pkgdir/usr" --sources-subdir=include/mustache \
		--build-name=relocatable --build-var=LIBRARY_TYPE
}

doc() {
	install -D -m644 "$builddir"/mustache-ada.3 \
		"$subpkgdir"/usr/share/man/man3/mustache-ada.3
	gzip "$subpkgdir"/usr/share/man/man3/mustache-ada.3
}

sha512sums="
af35f9a3d3a1d7ef5af5e3c956ae916161cb3dd5cd8f317737ef7eea91edaedc49dd09386cb3743988e7f078e2f64bb43c1f80a25709dfd1c0c2524852e02cd7    mustache-ada-v0.2.1.tar.gz
"
