# Maintainer: David Walther <david@clearbrookdistillery.com>
pkgname=py3-e3-core
pkgver=22.10.0_git20260914
pkgrel=0
_commit="2bfafcc7e12e1f24c6b22e99265e1028d11dae79"
pkgdesc="E3 core: tools and library for building and testing software"
url="https://github.com/AdaCore/e3-core"
arch="noarch"
license="GPL-3.0-only"
depends="python3 py3-defusedxml py3-colorama py3-yaml py3-dateutil py3-requests py3-requests-cache py3-requests-toolbelt py3-tqdm py3-stevedore py3-setuptools py3-packaging py3-resolvelib py3-psutil py3-distro"
makedepends="py3-setuptools py3-build py3-installer py3-wheel python3-dev"
subpackages="$pkgname-pyc:pyc:noarch"
source="e3-core-$_commit.tar.gz::https://github.com/AdaCore/e3-core/archive/$_commit.tar.gz"
builddir="$srcdir/e3-core-$_commit"

build() {
	python3 -m build --wheel --no-isolation
}

package() {
	python3 -m installer -d "$pkgdir" dist/*.whl
	# e3-core bundles precompiled rlimit helper binaries for many platforms.
	# They are glibc-built (won't run on musl), arch-specific (trip strip and
	# the textrel check), so drop them; e3.os falls back to Python's resource
	# module.
	find "$pkgdir" -path "*/e3/os/data/rlimit-*" -delete
}

sha512sums="
1ea679bbf63fce4ef58fb632b7ee90bf6c7af660c480916ab36b9f57b22edbc340a5755b7b990b376ed2d5f41d54b7dc666977d023a108cfa4aa98cf0634b5b1  e3-core-2bfafcc7e12e1f24c6b22e99265e1028d11dae79.tar.gz
"
