# Maintainer: David Walther <david@clearbrookdistillery.com>
pkgname=spawn
pkgver=26.0.0
pkgrel=0
pkgdesc="Ada process-spawning library"
url="https://github.com/AdaCore/spawn"
arch="all"
license="GPL-3.0-or-later WITH GCC-exception-3.1"
depends="libgnat"
makedepends="gcc-gnat gprbuild"
source="spawn-$pkgver.tar.gz::https://github.com/AdaCore/spawn/archive/refs/tags/v$pkgver.tar.gz"
builddir="$srcdir/spawn-$pkgver"

build() {
	# Build the library only; `make` also builds the test project, which
	# expects spawn to already be installed.
	gprbuild -p -P gnat/spawn.gpr
}

check() {
	# Stage-install and compile a trivial consumer against it.
	mkdir -p "$srcdir"/stage
	make install DESTDIR="$srcdir"/stage PREFIX=/usr
	printf 'with Spawn;\nprocedure Smoke is\nbegin\n   null;\nend Smoke;\n' > "$srcdir"/smoke.adb
	printf 'with "spawn";\nproject Smoke is\n   for Source_Dirs use (".");\n   for Object_Dir use "obj";\n   for Exec_Dir use ".";\n   for Main use ("smoke.adb");\n   for Source_Files use ("smoke.adb");\nend Smoke;\n' > "$srcdir"/smoke.gpr
	( cd "$srcdir" && GPR_PROJECT_PATH="$srcdir"/stage/usr/share/gpr gprbuild -p -P smoke.gpr )
}

package() {
	make install DESTDIR="$pkgdir" PREFIX=/usr
}

sha512sums="
e0c5252bee89216b44105e96080c194b81715e08f16ac844d2d6b771210f31b553ecf32cc2c57c0cbed1d6d33b94da20359bd2bfe0eddcdcb6ef3860a7e356b3  spawn-26.0.0.tar.gz
"
