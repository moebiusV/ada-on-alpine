# Maintainer: David Walther <david@clearbrookdistillery.com>
pkgname=vss
pkgver=25.0.0_git20250901
pkgrel=0
_commit="29344249f77afab2f00dc0e6a6e7d6a19bc0bf01"
pkgdesc="Vector/string abstractions library for Ada"
url="https://github.com/AdaCore/VSS"
arch="all"
license="GPL-3.0-or-later WITH GCC-exception-3.1"
depends="libgnat"
makedepends="gcc-gnat gprbuild xmlada"
source="vss-$_commit.tar.gz::https://github.com/AdaCore/VSS/archive/$_commit.tar.gz"
builddir="$srcdir/VSS-$_commit"

build() {
	make build-libs-release_static
	# Only vss_gnat + vss_text need a relocatable build (prettier_ada uses
	# vss_text). build-libs-release_relocatable would also build
	# vss_xml_xmlada, whose -XXMLADA_BUILD=relocatable xmlada rejects (its
	# build type is "static"/"shared").
	gprbuild -p -j0 -XVSS_BUILD_PROFILE=release -XVSS_LIBRARY_TYPE=relocatable gnat/vss_gnat.gpr
	gprbuild -p -j0 -XVSS_BUILD_PROFILE=release -XVSS_LIBRARY_TYPE=relocatable gnat/vss_text.gpr
}

check() {
	# Stage-install and verify the installed project/library layout.
	mkdir -p "$srcdir"/stage
	make install-libs-release_static DESTDIR="$srcdir"/stage PREFIX=/usr
	test -f "$srcdir"/stage/usr/share/gpr/vss_gnat.gpr
	test -f "$srcdir"/stage/usr/share/gpr/vss_text.gpr
	test -n "$(find "$srcdir"/stage/usr/lib -name 'libvss*.a' | head -1)"
}

package() {
	make install-libs-release_static DESTDIR="$pkgdir" PREFIX=/usr
	for lib in gnat text; do
		gprinstall \
			-XVSS_BUILD_PROFILE=release -XVSS_LIBRARY_TYPE=relocatable \
			--build-name=relocatable \
			--build-var=LIBRARY_TYPE --build-var=VSS_LIBRARY_TYPE \
			--prefix=/usr --exec-subdir="$pkgdir"/usr/bin \
			--lib-subdir="$pkgdir"/usr/lib/vss/relocatable \
			--project-subdir="$pkgdir"/usr/share/gpr \
			--link-lib-subdir="$pkgdir"/usr/lib \
			--sources-subdir="$pkgdir"/usr/include/vss/$lib \
			-f -p -P gnat/vss_$lib.gpr --install-name=vss_$lib
	done
}

sha512sums="
