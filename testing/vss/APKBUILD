# Maintainer: David Walther <david@clearbrookdistillery.com>
# NOTE: re-pinned to AdaCore/vss-text (the split-out text core). VSS was split
# upstream into vss_text (this package) + vss_extra (separate package, provides
# vss_os/vss_json/vss_regexp/vss_xml*). Pinned to a8e0e9493076 (2026-06-29),
# the last pre-GCC16 commit: vss-text HEAD requires GCC 16, but Alpine edge is
# GCC 15.2.0. Library_Name is now "vss-text" (was "vss"), so prettier-ada /
# langkit / libadalang must rebuild against it.
pkgname=vss
pkgver=26.0.0_git20260629
pkgrel=1
_commit="a8e0e94930767310ce983c09c9b7191cf9f48630"
pkgdesc="Unicode text-processing library (VSS text core)"
url="https://github.com/AdaCore/vss-text"
arch="all"
license="Apache-2.0 WITH LLVM-exception"
depends="libgnat"
makedepends="gcc-gnat gprbuild"
subpackages="$pkgname-static"
source="vss-text-$_commit.tar.gz::https://github.com/AdaCore/vss-text/archive/$_commit.tar.gz"
builddir="$srcdir/vss-text-$_commit"

build() {
	make build-libs-release_static
	# relocatable vss_text + its vss_gnat dep for prettier-ada/langkit's
	# shared liblktlang.
	gprbuild -p -j0 -XVSS_BUILD_PROFILE=release -XVSS_LIBRARY_TYPE=relocatable gnat/vss_gnat.gpr
	gprbuild -p -j0 -XVSS_BUILD_PROFILE=release -XVSS_LIBRARY_TYPE=relocatable gnat/vss_text.gpr
}

check() {
	# Stage-install and verify the installed project/library layout.
	mkdir -p "$srcdir"/stage
	make install-libs-release_static DESTDIR="$srcdir"/stage PREFIX=/usr
	test -f "$srcdir"/stage/usr/share/gpr/vss_text.gpr
	test -n "$(find "$srcdir"/stage/usr/lib -name 'libvss-text.a' | head -1)"
}

package() {
	make install-libs-release_static DESTDIR="$pkgdir" PREFIX=/usr
	for lib in gnat text; do
		gprinstall \
			-XVSS_BUILD_PROFILE=release -XVSS_LIBRARY_TYPE=relocatable \
			--build-name=relocatable \
			--build-var=LIBRARY_TYPE --build-var=VSS_LIBRARY_TYPE \
			--prefix=/usr --exec-subdir="$pkgdir"/usr/bin \
			--lib-subdir="$pkgdir"/usr/lib/vss/relocatable \
			--project-subdir="$pkgdir"/usr/share/gpr \
			--link-lib-subdir="$pkgdir"/usr/lib \
			--sources-subdir="$pkgdir"/usr/include/vss/$lib \
			-f -p -P gnat/vss_$lib.gpr --install-name=vss_$lib
	done
}

sha512sums="
e5cfb9a4d882c043c07e42de5e87de4c2e6646a09b29b3ef5372cf0032e01ebffd4c6c6db666cabc335e30bd43725a6e38c3bd73343ca4508f19ca9522752298  vss-text-a8e0e94930767310ce983c09c9b7191cf9f48630.tar.gz
"
