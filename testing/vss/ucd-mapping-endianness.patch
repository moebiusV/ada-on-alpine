    begin
       return
-        VSS.Implementation.UCD_Casing_UTF8.Simplified_Mapping_Data_Table
-          (Mapping (Group) + Offset);
+        (Offset  =>
+           VSS.Implementation.UCD_Casing_UTF8.Casing_UTF8_Data_Offset
+             (Field (0, 15)),
+         Length  =>
+           VSS.Implementation.UCD_Casing_UTF8
