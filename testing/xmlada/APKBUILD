# Maintainer: David Walther <david@clearbrookdistillery.com>
pkgname=xmlada
pkgver=26.0.0_git20260615
pkgrel=0
_commit="9823ffb294187897a08b14bbce00743ff647cae1"
pkgdesc="XML/Ada: XML, schema, and DOM parsing library for Ada"
url="https://github.com/AdaCore/xmlada"
arch="all"
license="GPL-3.0-or-later WITH GCC-exception-3.1"
depends="libgnat"
makedepends="gcc-gnat build-base gprbuild which gawk"
source="xmlada-$_commit.tar.gz::https://github.com/AdaCore/xmlada/archive/$_commit.tar.gz"
builddir="$srcdir/xmlada-$_commit"

build() {
	./configure --prefix=/usr --disable-shared
	make static GPROPTS_EXTRA="-j${JOBS:-1} -cargs $CFLAGS -largs $LDFLAGS"
}

check() {
	# Upstream's tests need an installed XML/Ada; stage-install and point
	# GPR_PROJECT_PATH at the staged tree.
	DESTDIR="$srcdir"/stage make -j1 install
	GPR_PROJECT_PATH="$srcdir"/stage/usr/share/gpr make test
	GPR_PROJECT_PATH="$srcdir"/stage/usr/share/gpr make check
}

package() {
	make -j1 install DESTDIR="$pkgdir"
}

sha512sums="
fb5718ee5e3a6932eacbf861aef3d75718e5892cf28ac49697fb589839517e721ff4533ef046ca25ed291af235c9b92d9d5383e3ed4be48a35d789411fc30db4  xmlada-9823ffb294187897a08b14bbce00743ff647cae1.tar.gz
"
