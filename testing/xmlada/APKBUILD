# Maintainer: David Walther <david@clearbrookdistillery.com>
pkgname=xmlada
pkgver=26.0.0_git20260615
pkgrel=1
_commit="9823ffb294187897a08b14bbce00743ff647cae1"
pkgdesc="XML/Ada: XML, schema, and DOM parsing library for Ada"
url="https://github.com/AdaCore/xmlada"
arch="all"
license="GPL-3.0-or-later WITH GCC-exception-3.1"
depends="libgnat"
makedepends="gcc-gnat build-base gprbuild which gawk"
subpackages="$pkgname-static"
source="xmlada-$_commit.tar.gz::https://github.com/AdaCore/xmlada/archive/$_commit.tar.gz"
builddir="$srcdir/xmlada-$_commit"

build() {
	# Default --enable-shared builds static + relocatable + static-pic in one
	# pass; each kind gets its own obj/<kind>/ + lib/<kind>/ (see the .gpr's
	# `for Object_Dir use "obj/" & Project'Library_Kind`), so no -fPIC clash.
	./configure --prefix=/usr
	# Alpine's CFLAGS carries C-only warning flags (-Wformat
	# -Werror=format-security) that gnat1 rejects; strip the -W* family so only
	# the gcc-common hardening/optimization flags reach -cargs.
	_ada_cflags=$(echo "$CFLAGS" | sed 's/-W[^ ]*//g')
	make GPROPTS_EXTRA="-j${JOBS:-1} -cargs $_ada_cflags -largs $LDFLAGS"
}

check() {
	# Upstream's tests need an installed XML/Ada; stage-install and point
	# GPR_PROJECT_PATH at the staged tree (make test builds statically).
	DESTDIR="$srcdir"/stage make -j1 install
	GPR_PROJECT_PATH="$srcdir"/stage/usr/share/gpr make test
	GPR_PROJECT_PATH="$srcdir"/stage/usr/share/gpr make check
}

package() {
	make -j1 install DESTDIR="$pkgdir"

	# gprinstall leaves the versioned SONAMEs (libxmlada_*.so.18.0w) as relative
	# symlinks into usr/lib/xmlada/*.relocatable/. abuild's soname tracer runs
	# `scanelf --soname` non-recursively over usr/lib and skips symlinks, so
	# promote those versioned libs to real files at the top of usr/lib.
	for _so in "$pkgdir"/usr/lib/*.so.*; do
		[ -L "$_so" ] || continue
		_target=$(readlink -f "$_so")
		rm -f "$_so"
		cp -a "$_target" "$_so"
	done
}

sha512sums="
fb5718ee5e3a6932eacbf861aef3d75718e5892cf28ac49697fb589839517e721ff4533ef046ca25ed291af235c9b92d9d5383e3ed4be48a35d789411fc30db4  xmlada-9823ffb294187897a08b14bbce00743ff647cae1.tar.gz
"
