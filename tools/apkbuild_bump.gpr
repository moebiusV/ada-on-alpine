project Apkbuild_Bump is

   for Languages use ("Ada");
   for Source_Dirs use (".");
   for Main use ("apkbuild_bump.adb");
   for Object_Dir use ".obj";
   for Create_Missing_Dirs use "True";
   for Exec_Dir use ".";

   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnatwa");
   end Compiler;

end Apkbuild_Bump;
